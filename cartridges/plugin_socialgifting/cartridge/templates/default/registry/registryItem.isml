<article class="sg-card">
    <isif condition="${item.image}"><img class="w-100" src="${item.image}" alt="" width="240" height="240" loading="lazy" /></isif>
    <h2><isprint value="${item.name}" encoding="htmlcontent" /></h2>
    <p><isprint value="${item.price}" encoding="htmlcontent" /></p>
    <p><isprint value="${item.notes}" encoding="htmlcontent" /></p>
    <p>${Resource.msg('quantity.wanted', 'socialgifting', null)}: ${item.quantity}</p>
    <isif condition="${item.purchased !== null}"><p>${Resource.msg('quantity.purchased', 'socialgifting', null)}: ${item.purchased} · ${Resource.msg('quantity.reserved', 'socialgifting', null)}: ${item.reserved}</p></isif>
    <isif condition="${item.remaining !== null}"><p>${Resource.msg('quantity.remaining', 'socialgifting', null)}: ${item.remaining.toFixed(0)}</p></isif>
    <isif condition="${item.groupGift}"><a class="btn btn-primary" href="${URLUtils.https('GroupGift-View', 'key', item.groupGift.key)}">${Resource.msg('group.contribute', 'socialgifting', null)} · ${item.groupGift.collected} / ${item.groupGift.target} ${item.groupGift.currency}</a>
    <iselseif condition="${pdict.registry.canGift && (item.remaining > 0 || !!item.reservationKey)}" />
        <isif condition="${pdict.registry.canReserve && !item.reservationKey}"><form class="sg-form" action="${URLUtils.https('RegistryReservation-Create')}" method="post"><isinclude template="registry/context" /><input type="hidden" name="itemKey" value="${item.key}" /><input type="hidden" name="reservationKey" value="${item.reservationKey}" /><input type="hidden" name="quantity" value="1" /><button class="btn btn-outline-primary" type="submit">${Resource.msg('gift.reserve', 'socialgifting', null)}</button></form></isif>
        <isif condition="${pdict.registry.canPurchase}"><form class="sg-form" action="${URLUtils.https('RegistryCheckout-Add')}" method="post"><isinclude template="registry/context" /><input type="hidden" name="itemKey" value="${item.key}" /><input type="hidden" name="reservationKey" value="${item.reservationKey}" /><input type="hidden" name="quantity" value="1" /><label>${Resource.msg('email', 'socialgifting', null)}<input type="email" class="form-control" name="email" /></label><isif condition="${pdict.registry.allowAnonymous}"><label class="sg-check d-flex align-items-center"><input type="checkbox" name="anonymous" value="true" /> ${Resource.msg('gift.anonymous', 'socialgifting', null)}</label></isif><button class="btn btn-primary" type="submit">${Resource.msg('gift.buy', 'socialgifting', null)}</button></form></isif>
    <iselseif condition="${item.remaining === 0}" /><p>${Resource.msg('error.GIFT_ALREADY_PURCHASED', 'socialgifting', null)}</p><a href="${URLUtils.https('Search-Show')}">${Resource.msg('gift.alternatives', 'socialgifting', null)}</a></isif>
    <isif condition="${!!item.reservationKey}"><form class="sg-form" action="${URLUtils.https('RegistryReservation-Cancel')}" method="post"><isinclude template="registry/context" /><input type="hidden" name="reservationKey" value="${item.reservationKey}" /><button class="btn btn-link" type="submit">${Resource.msg('reservation.cancel', 'socialgifting', null)}</button></form></isif>
    <isif condition="${pdict.registry.canManage}">
        <form class="sg-form" action="${URLUtils.https('Registry-UpdateProduct')}" method="post"><isinclude template="registry/context" /><input type="hidden" name="itemKey" value="${item.key}" /><label>${Resource.msg('quantity', 'socialgifting', null)}<input class="form-control" type="number" name="quantity" value="${item.quantity}" min="1" max="1000" required /></label><label>${Resource.msg('notes', 'socialgifting', null)}<textarea class="form-control" name="notes" maxlength="1000"><isprint value="${item.notes}" encoding="htmlcontent" /></textarea></label><button class="btn btn-link" type="submit">${Resource.msg('save', 'socialgifting', null)}</button></form>
        <form class="sg-form" action="${URLUtils.https('Registry-RemoveProduct')}" method="post"><isinclude template="registry/context" /><input type="hidden" name="itemKey" value="${item.key}" /><button class="btn btn-link" type="submit">${Resource.msg('remove', 'socialgifting', null)}</button></form>
        <isif condition="${pdict.registry.canGroupGift && item.allowGroupGifting && !item.groupGift}"><form class="sg-form" action="${URLUtils.https('GroupGift-Create')}" method="post"><isinclude template="registry/context" /><input type="hidden" name="itemKey" value="${item.key}" /><button class="btn btn-link" type="submit">${Resource.msg('group.create', 'socialgifting', null)}</button></form></isif>
    </isif>
    <isloop items="${item.comments}" var="comment"><p><strong><isprint value="${comment.author}" encoding="htmlcontent" /></strong>: <isprint value="${comment.text}" encoding="htmlcontent" /></p><isif condition="${comment.canDelete}"><form class="sg-form" action="${URLUtils.https('RegistryComment-Delete')}" method="post"><isinclude template="registry/context" /><input type="hidden" name="commentKey" value="${comment.key}" /><button class="btn btn-link" type="submit">${Resource.msg('remove', 'socialgifting', null)}</button></form></isif></isloop>
    <isif condition="${pdict.registry.canComment}"><form class="sg-form" action="${URLUtils.https('RegistryComment-Add')}" method="post"><isinclude template="registry/context" /><input type="hidden" name="itemKey" value="${item.key}" /><label>${Resource.msg('comment.add', 'socialgifting', null)}<textarea class="form-control" name="text" maxlength="2000" required></textarea></label><button class="btn btn-outline-primary" type="submit">${Resource.msg('comment.add', 'socialgifting', null)}</button></form></isif>
</article>
