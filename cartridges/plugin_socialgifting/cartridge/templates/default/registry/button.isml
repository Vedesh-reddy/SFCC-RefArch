<isinclude template="registry/assets" /><isif condition="${pdict.loggedIn && pdict.registries.length}"><form class="sg-form sg-product-add" action="${URLUtils.https('Registry-AddProduct')}" method="post"><isinclude template="registry/csrf" /><input type="hidden" name="pid" value="${pdict.pid}" /><input type="hidden" name="quantity" value="1" /><label>${Resource.msg('dashboard.title', 'socialgifting', null)}<select class="form-select" name="registryKey"><isloop items="${pdict.registries}" var="registry"><option value="${registry.key}"><isprint value="${registry.name}" encoding="htmlcontent" /></option></isloop></select></label><button class="btn btn-outline-primary" type="submit">${Resource.msg('product.add', 'socialgifting', null)}</button></form><p class="sg-message" role="status" aria-live="polite"></p><iselse/><a href="${URLUtils.https('Registry-Dashboard')}">${Resource.msg('dashboard.title', 'socialgifting', null)}</a></isif>
