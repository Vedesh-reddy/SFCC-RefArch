<isdecorate template="common/layout/page"><isinclude template="registry/assets" /><main class="container sg-page"><h1>${Resource.msg('invitation.title', 'socialgifting', null)}</h1><isif condition="${pdict.loggedIn}"><form class="sg-form" action="${URLUtils.https('Registry-ConfirmInvite')}" method="post"><isinclude template="registry/csrf" /><button class="btn btn-primary" type="submit">${Resource.msg('invitation.accept', 'socialgifting', null)}</button></form><iselse/><p>${Resource.msg('invitation.login', 'socialgifting', null)}</p><a href="${URLUtils.https('Login-Show')}">${Resource.msg('login', 'socialgifting', null)}</a></isif><p class="sg-message" role="status" aria-live="polite"></p></main></isdecorate>
