<isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
    <isinclude template="reporting/reportingUrls" />
</isif>

<isscript>
    var categoryLinks = pdict.productSearch.isCategorySearch
        ? require('*/cartridge/scripts/helpers/categoryNavHelpers').getCategoryLinks(pdict.productSearch.category.id)
        : [];
</isscript>
<div class="search-hero">
    <div class="container text-center">
        <isif condition="${pdict.productSearch.isCategorySearch}">
            <h1 class="header page-title">${pdict.productSearch.category.name}</h1>
        <iselse>
            <h1 class="page-title">${pdict.productSearch.searchKeywords ? pdict.productSearch.searchKeywords : ''}</h1>
        </isif>
        <isif condition="${categoryLinks.length > 0}">
            <nav class="search-hero-links" aria-label="${Resource.msg('label.category.links', 'storefront', null)}">
                <ul class="d-flex list-unstyled m-0 justify-content-md-center">
                    <isloop items="${categoryLinks}" var="categoryLink">
                        <li class="flex-shrink-0"><a class="search-hero-link ${categoryLink.active ? 'is-active' : ''}" href="${categoryLink.url}" <isif condition="${categoryLink.active}">aria-current="page"</isif>>${categoryLink.name}</a></li>
                    </isloop>
                </ul>
            </nav>
        </isif>
    </div>
</div>

<div class="container search-results">
    <div class="row search-nav">
        <isif condition="${!pdict.productSearch.isCategorySearch}">
            <div class="nav-tabs-wrapper">
                <ul class="nav nav-tabs nav-fill" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active product-search" href="#product-search-results" aria-controls="product-search-results" data-bs-toggle="tab" data-toggle="tab" role="tab" aria-selected="true" id="product-tab">
                            ${Resource.msg('tab.nav.search.productsresults', 'search', null)}
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link content-search" href="#content-search-results-pane" aria-controls="content-search-results-pane" data-bs-toggle="tab" data-toggle="tab" role="tab" aria-selected="false" tabindex="0" id="articles-tab"
                            data-url="${URLUtils.url('Search-Content', 'q', pdict.productSearch.searchKeywords, 'startingPage', 0)}">
                            ${Resource.msg('tab.nav.search.artclesresults', 'search', null)}
                        </a>
                    </li>
                </ul>
            </div>
        </isif>
    </div>
    <div class="tab-content">
        <div class="tab-pane active" id="product-search-results" role="tabpanel" aria-labelledby="product-tab">
            <div class="search-toolbar d-flex flex-wrap align-items-center justify-content-between">
                <div class="grid-header flex-grow-1">
                    <div class="result-count">
                        <isinclude template="search/resultsCount" />
                    </div>
                </div>
                <isif condition="${pdict.productSearch.productIds.length > 0}">
                    <div class="d-flex align-items-center gap-2">
                        <isinclude template="search/sortOrderMenu" />
                        <button type="button" class="btn btn-outline-primary filter-results">
                            <i class="fa fa-sliders" aria-hidden="true"></i>
                            ${Resource.msg('button.filter', 'search', null)}
                        </button>
                    </div>
                </isif>
            </div>

            <isif condition="${pdict.productSearch.productIds.length > 0}">
                <div class="row">
                    <div class="refinement-bar">
                        <isinclude url="${pdict.refineurl}"/>
                    </div>

                    <div class="col-12">
                        <div class="row filter-bar">
                            <isinclude template="search/filterBar" />
                        </div>

                        <div class="row product-grid" itemtype="http://schema.org/SomeProducts" itemid="#product">
                            <isinclude template="search/productGrid" />
                        </div>
                    </div>
                </div>
            </isif>
        </div>
        <div class="tab-pane" id="content-search-results-pane" role="tabpanel" aria-labelledby="articles-tab">
            <div id="content-search-results" class="content-grid-header"></div>
        </div>
    </div>
</div>
