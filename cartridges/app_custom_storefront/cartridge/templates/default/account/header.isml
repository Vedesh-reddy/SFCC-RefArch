<isif condition="${pdict.name === null}">
    <div class="user hidden-md-down">
        <a href="${URLUtils.https('Login-Show')}" role="button" aria-label="${Resource.msg('label.header.loginbutton', 'account', null)}">
            <svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-user"></use></svg>
            <span class="user-message">${Resource.msg('link.header.login', 'account', null)}</span>
        </a>
    </div>
<iselse/>
    <isif condition="${pdict.walletHeader}">
        <div class="wallet-header nav-item">
            <a href="${URLUtils.https('Wallet-Show')}" class="wallet-header-link" aria-label="${Resource.msgf('header.wallet.label', 'wallet', null, pdict.walletHeader.balance)}">
                <svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-wallet"></use></svg>
                <span class="wallet-header-amount">${pdict.walletHeader.balance}</span>
            </a>
        </div>
    </isif>
    <div class="user hidden-md-down nav-item">
        <a href="${'#'}" id="myaccount" aria-haspopup="true" aria-label="${Resource.msg('link.header.myaccount', 'account', null)}" role="button">
            <svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-user"></use></svg>
            <span class="user-message">${pdict.name}</span>
        </a>
        <div class="popover popover-bottom">
            <p class="account-menu-name">${pdict.name}</p>
            <ul class="nav" role="menu" aria-label="${Resource.msg('label.profile.myaccountlink', 'account', null)}">
                <li class="nav-item" role="presentation"><a href="${URLUtils.https('Account-Show')}" role="menuitem" tabindex="0"><svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-user"></use></svg>${Resource.msg('link.header.myaccount', 'account', null)}</a></li>
                <li class="nav-item" role="presentation"><a href="${URLUtils.url('Order-History')}" role="menuitem" tabindex="0"><svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-box"></use></svg>${Resource.msg('label.myorders', 'account', null)}</a></li>
                <li class="nav-item" role="presentation"><a href="${URLUtils.https('Wallet-Show')}" role="menuitem" tabindex="0"><svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-wallet"></use></svg>${Resource.msg('feature.wallet', 'storefront', null)}</a></li>
                <li class="nav-item" role="presentation"><a href="${URLUtils.url('PrimeMembership-Dashboard')}" role="menuitem" tabindex="0"><svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-crown"></use></svg>${Resource.msg('feature.prime', 'storefront', null)}</a></li>
                <li class="nav-item" role="presentation"><a href="${URLUtils.https('CustomWishlist-Show')}" role="menuitem" tabindex="0"><svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-heart"></use></svg>${Resource.msg('feature.wishlist', 'storefront', null)}</a></li>
                <li class="nav-item" role="presentation"><a href="${URLUtils.https('Loyalty-Show')}" role="menuitem" tabindex="0"><svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-star"></use></svg>${Resource.msg('footer.link.rewards', 'storefront', null)}</a></li>
                <li class="nav-item" role="presentation"><a href="${URLUtils.https('Rental-Bookings')}" role="menuitem" tabindex="0"><svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-calendar"></use></svg>${Resource.msg('footer.link.rentals', 'storefront', null)}</a></li>
                <li class="nav-item" role="presentation"><a href="${URLUtils.https('Registry-Dashboard')}" role="menuitem" tabindex="0"><svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-list"></use></svg>${Resource.msg('footer.link.registry', 'storefront', null)}</a></li>
                <li class="nav-item account-menu-logout" role="presentation"><a href="${URLUtils.url('Login-Logout')}" role="menuitem" tabindex="0"><svg class="store-icon" aria-hidden="true"><use href="${'#'}icon-logout"></use></svg>${Resource.msg('link.header.logout', 'account', null)}</a></li>
            </ul>
        </div>
    </div>
</isif>
