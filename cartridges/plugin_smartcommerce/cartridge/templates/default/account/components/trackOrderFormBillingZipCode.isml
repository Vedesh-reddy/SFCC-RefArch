<div class="mb-3 required">
    <label class="form-label" for="trackorder-form-zip">
        ${Resource.msg('label.input.trackorder.postalcode', 'login', null)}
    </label>
    <input
        type="text"
        required
        class="form-control"
        id="trackorder-form-zip"
        aria-describedby="form-zipcode-error"
        name="trackOrderPostal"
        pattern="(^\d{5}(-\d{4})?$)|(^[abceghjklmnprstvxyABCEGHJKLMNPRSTVXY]{1}\d{1}[A-Za-z]{1} *\d{1}[A-Za-z]{1}\d{1}$)">
    <div class="invalid-feedback" id="form-zipcode-error"></div>
</div>
<p class="smart-order-lookup-link">
    <a href="${URLUtils.https('OrderLookup-Show')}">${Resource.msg('lookup.link', 'smartcommerce', null)}</a>
</p>
