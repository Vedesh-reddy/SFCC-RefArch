<isdecorate template="common/layout/page">
    <div class="container smart-order-lookup-page py-4">
        <div class="row justify-content-center">
            <div class="col-sm-8 col-md-6">
                <h1 class="page-title">${Resource.msg('lookup.title', 'smartcommerce', null)}</h1>
                <p>${Resource.msg('lookup.intro', 'smartcommerce', null)}</p>
                <isif condition="${pdict.error}">
                    <div class="alert alert-danger" role="alert">${pdict.error}</div>
                </isif>
                <form action="${URLUtils.https('OrderLookup-Request')}" method="post" class="smart-order-lookup-form">
                    <div class="mb-3">
                        <label class="form-label" for="smart-lookup-order">${Resource.msg('lookup.label.order', 'smartcommerce', null)}</label>
                        <input type="text" class="form-control" id="smart-lookup-order" name="orderNo" maxlength="50" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="smart-lookup-contact">${Resource.msg('lookup.label.contact', 'smartcommerce', null)}</label>
                        <input type="text" class="form-control" id="smart-lookup-contact" name="contact" maxlength="100" autocomplete="email" required />
                    </div>
                    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
                    <button type="submit" class="btn btn-primary w-100">${Resource.msg('lookup.button', 'smartcommerce', null)}</button>
                </form>
            </div>
        </div>
    </div>
</isdecorate>
