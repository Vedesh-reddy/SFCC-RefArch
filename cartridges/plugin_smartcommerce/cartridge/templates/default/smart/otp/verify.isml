<isdecorate template="common/layout/page">
    <div class="container smart-otp-page py-4">
        <div class="row justify-content-center">
            <div class="col-sm-8 col-md-6">
                <h1 class="page-title">${pdict.title}</h1>
                <p role="status">${Resource.msgf('otp.sent', 'smartcommerce', null, pdict.destination)}</p>
                <isif condition="${pdict.error}">
                    <div class="alert alert-danger" role="alert">${pdict.error}</div>
                </isif>
                <form action="${pdict.actionUrl}" method="post" class="smart-otp-verify-form">
                    <div class="mb-3">
                        <label class="form-label" for="smart-otp-code">${Resource.msg('otp.label.code', 'smartcommerce', null)}</label>
                        <input type="text" class="form-control" id="smart-otp-code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus />
                    </div>
                    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
                    <button type="submit" class="btn btn-primary w-100">${Resource.msg('otp.button.verify', 'smartcommerce', null)}</button>
                </form>
                <p class="mt-3"><a href="${pdict.backUrl}">${Resource.msg('otp.resend', 'smartcommerce', null)}</a></p>
            </div>
        </div>
    </div>
</isdecorate>
