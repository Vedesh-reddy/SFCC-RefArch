<div class="product-number-rating clearfix">
    <!-- Product Number -->
    <div class="product-number float-start">
        <isinclude template="product/components/productNumber" />
    </div>

    <!-- Product Rating -->
    <div class="ratings float-end">
        <span class="visually-hidden">${Resource.msgf('label.product.ratings', 'common', null, product.rating)}</span>
        <isinclude template="product/components/productRating" />
    </div>
</div>
