{
    "step-types": {
        "script-module-step": [
            {
                "@type-id": "custom.Wallet.Holds",
                "@supports-parallel-execution": "false",
                "@supports-site-context": "true",
                "@supports-organization-context": "false",
                "description": "Capture holds of placed orders, release failed/cancelled ones, review stuck holds, expire approvals and invitations",
                "module": "plugin_wallet/cartridge/scripts/jobs/wallet.js",
                "function": "holds",
                "transactional": "false",
                "timeout-in-seconds": 1800,
                "parameters": {
                    "parameter": [
                        {
                            "@name": "MaxItems",
                            "@type": "long",
                            "@required": "false",
                            "description": "Maximum records per run",
                            "default-value": "500",
                            "min-value": "1",
                            "max-value": "10000"
                        }
                    ]
                },
                "status-codes": {
                    "status": [
                        {
                            "@code": "OK",
                            "description": "Completed"
                        },
                        {
                            "@code": "ERROR",
                            "description": "Failed, partial or mismatches found; see the plugin-wallet log"
                        }
                    ]
                }
            },
            {
                "@type-id": "custom.Wallet.TopUps",
                "@supports-parallel-execution": "false",
                "@supports-site-context": "true",
                "@supports-organization-context": "false",
