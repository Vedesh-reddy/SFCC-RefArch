<iscomment>Remote include rendered by Marketplace-Offers. No shopper data and no CSRF token, so it can be cached.</iscomment>
<isscript>var formatCents = require('*/cartridge/scripts/helpers/marketplaceHelpers').formatCents;</isscript>
<isif condition="${pdict.offers.length > 0}">
    <section class="marketplace-offers mt-3" aria-labelledby="marketplace-offers-title-${pdict.pid}" data-pid="${pdict.pid}">
        <h2 class="h6" id="marketplace-offers-title-${pdict.pid}">${Resource.msg('offers.block.heading', 'seller', null)}</h2>
        <ul class="list-unstyled mb-0">
            <isloop items="${pdict.offers}" var="offer">
                <li class="marketplace-offer card mb-2 ${offer.featured ? 'marketplace-offer-featured' : ''}">
                    <div class="card-body d-flex flex-wrap justify-content-between align-items-center">
                        <div class="mr-2 me-2">
                            <isif condition="${offer.featured}"><span class="badge badge-success bg-success">${Resource.msg('offers.block.featured', 'seller', null)}</span></isif>
                            <span class="d-block h5 mb-1">${formatCents(offer.priceCents)}</span>
                            <span class="d-block small">
                                <a href="${URLUtils.url('Marketplace-Seller', 'id', offer.sellerId)}">${Resource.msgf('offers.block.soldby', 'seller', null, offer.sellerName)}</a>
                                &middot;
                                <isif condition="${offer.ratingCount > 0}">${Resource.msgf('offers.block.rating', 'seller', null, offer.rating.toFixed(1), offer.ratingCount.toFixed(0))}<iselse/>${Resource.msg('offers.block.norating', 'seller', null)}</isif>
                            </span>
                            <span class="d-block small text-muted">
                                ${Resource.msg('offer.condition.' + offer.condition, 'seller', offer.condition)}
                                &middot; ${Resource.msgf('offers.block.handling', 'seller', null, offer.handlingDays.toFixed(0))}
                                &middot; <isif condition="${offer.returnable && offer.returnDays > 0}">${Resource.msgf('offers.block.returns', 'seller', null, offer.returnDays.toFixed(0))}<iselse/>${Resource.msg('offers.block.noreturns', 'seller', null)}</isif>
                                <isif condition="${offer.shippingFeeCents > 0}">&middot; ${Resource.msgf('offers.block.shipping', 'seller', null, formatCents(offer.shippingFeeCents))}</isif>
                                <isif condition="${offer.shippingFeeCents > 0 && offer.freeShippingOverCents > 0}">&middot; ${Resource.msgf('offers.block.freeover', 'seller', null, formatCents(offer.freeShippingOverCents))}</isif>
                            </span>
                        </div>
                        <div class="text-right text-end">
                            <button type="button" class="btn btn-primary btn-sm marketplace-add-offer"
                                data-url="${URLUtils.url('Cart-AddProduct')}" data-pid="${pdict.pid}" data-offer-id="${offer.offerId}"
                                aria-label="${Resource.msgf('offers.block.add.label', 'seller', null, offer.sellerName, formatCents(offer.priceCents))}">${Resource.msg('offers.block.add', 'seller', null)}</button>
                            <a class="d-block small mt-1" href="${URLUtils.url('Marketplace-Report', 'offerId', offer.offerId)}" rel="nofollow">${Resource.msg('offers.block.report', 'seller', null)}</a>
                        </div>
                    </div>
                </li>
            </isloop>
        </ul>
        <p class="marketplace-offers-status small mb-0" role="status" aria-live="polite"></p>
    </section>
</isif>
