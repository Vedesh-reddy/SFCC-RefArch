<form class="seller-document-upload" action="${URLUtils.url('Seller-UploadDocument')}" method="post" enctype="multipart/form-data">
    <div class="form-row row align-items-end">
        <div class="form-group col-12 col-md-4">
            <label class="form-control-label" for="seller-doc-type">${Resource.msg('application.document.type', 'seller', null)}</label>
            <select class="form-control custom-select" id="seller-doc-type" name="docType" required>
                <isloop items="${pdict.documentTypes}" var="type">
                    <option value="${type}">${Resource.msg('doctype.' + type, 'seller', type)}</option>
                </isloop>
            </select>
        </div>
        <div class="form-group col-12 col-md-4">
            <label class="form-control-label" for="seller-doc-file">${Resource.msgf('application.document.file', 'seller', null, pdict.maxMegabytes || '5')}</label>
            <input class="form-control-file form-control" id="seller-doc-file" type="file" name="document" accept="application/pdf,image/png,image/jpeg" required />
        </div>
        <div class="form-group col-12 col-md-4">
            <label class="form-control-label" for="seller-doc-expires">${Resource.msg('application.document.expires', 'seller', null)}</label>
            <input class="form-control" id="seller-doc-expires" type="date" name="expiresOn" />
        </div>
    </div>
    <input type="hidden" name="back" value="${pdict.documentBack || 'application'}" />
    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
    <button class="btn btn-outline-primary btn-sm" type="submit">${Resource.msg('application.document.upload', 'seller', null)}</button>
</form>
