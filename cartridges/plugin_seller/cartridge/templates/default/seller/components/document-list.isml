<isif condition="${pdict.documents.length > 0}">
    <ul class="list-group mb-3 seller-documents">
        <isloop items="${pdict.documents}" var="doc">
            <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap">
                <span>
                    <span class="font-weight-bold fw-bold">${Resource.msg('doctype.' + doc.docType, 'seller', doc.docType)}</span>
                    <span class="d-block small text-muted">${doc.fileName} &middot; ${Resource.msg('docstate.' + doc.reviewStatus, 'seller', doc.reviewStatus)} &middot; ${Resource.msg('scan.' + doc.scanStatus, 'seller', doc.scanStatus)}<isif condition="${!empty(doc.expiresOn)}"> &middot; ${doc.expiresOn.toISOString().slice(0, 10)}</isif></span>
                </span>
                <isif condition="${doc.reviewStatus === 'PENDING' && (pdict.seller.status === 'DRAFT' || pdict.seller.status === 'REJECTED') && pdict.role === 'OWNER'}">
                    <form action="${URLUtils.url('Seller-WithdrawDocument')}" method="post">
                        <input type="hidden" name="documentId" value="${doc.documentId}" />
                        <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
                        <button class="btn btn-link btn-sm" type="submit">${Resource.msg('application.document.withdraw', 'seller', null)}</button>
                    </form>
                </isif>
            </li>
        </isloop>
    </ul>
</isif>
