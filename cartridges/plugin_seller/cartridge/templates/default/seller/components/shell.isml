<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/seller-central.css');
    </isscript>
    <div class="container seller-central py-4">
        <div class="row">
            <div class="col-12 col-lg-3 mb-3">
                <isinclude template="seller/components/nav" />
            </div>
            <main class="col-12 col-lg-9" id="seller-main" aria-labelledby="seller-page-title">
                <isinclude template="seller/components/flash" />
                <isreplace/>
            </main>
        </div>
    </div>
</isdecorate>
