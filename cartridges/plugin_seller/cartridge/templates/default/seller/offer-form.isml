<isdecorate template="seller/components/shell">
    <isset name="o" value="${pdict.offer}" scope="page" />
    <isset name="of" value="${pdict.offerForm}" scope="page" />
    <h1 id="seller-page-title">${Resource.msg('offer.heading', 'seller', null)}</h1>
    <p>${Resource.msgf('offer.product', 'seller', null, pdict.productName ? pdict.productName + ' (' + pdict.pid + ')' : pdict.pid)}</p>
    <isif condition="${o}"><p><span class="badge badge-info bg-info">${Resource.msg('status.' + o.status, 'seller', o.status)}</span></p></isif>
    <form class="seller-offer-form" action="${URLUtils.url('Seller-SaveOffer')}" method="post">
        <div class="form-row row">
            <div class="form-group col-6 col-md-4">
                <label class="form-control-label" for="offer-price">${Resource.msg('offer.price', 'seller', null)}</label>
                <input class="form-control" id="offer-price" name="${of.price.htmlName}" required inputmode="decimal" pattern="\d{1,9}(\.\d{1,2})?" value="${of.price.htmlValue}" />
            </div>
            <isif condition="${!o}">
                <div class="form-group col-6 col-md-4">
                    <label class="form-control-label" for="offer-quantity">${Resource.msg('offer.quantity', 'seller', null)}</label>
                    <input class="form-control" id="offer-quantity" name="${of.quantity.htmlName}" type="number" min="0" max="100000" required />
                </div>
            </isif>
            <div class="form-group col-12 col-md-4">
                <label class="form-control-label" for="offer-sku">${Resource.msg('offer.sku', 'seller', null)}</label>
                <input class="form-control" id="offer-sku" name="${of.sellerSku.htmlName}" required maxlength="40" value="${of.sellerSku.htmlValue}" />
            </div>
            <div class="form-group col-12 col-md-4">
                <label class="form-control-label" for="offer-condition">${Resource.msg('offer.condition', 'seller', null)}</label>
                <select class="form-control custom-select" id="offer-condition" name="${of.condition.htmlName}">
                    <option value="NEW" <isif condition="${of.condition.htmlValue !== 'REFURBISHED'}">selected</isif>>${Resource.msg('offer.condition.NEW', 'seller', null)}</option>
                    <option value="REFURBISHED" <isif condition="${of.condition.htmlValue === 'REFURBISHED'}">selected</isif>>${Resource.msg('offer.condition.REFURBISHED', 'seller', null)}</option>
                </select>
            </div>
            <div class="form-group col-6 col-md-4">
                <label class="form-control-label" for="offer-handling">${Resource.msg('offer.handling', 'seller', null)}</label>
                <input class="form-control" id="offer-handling" name="${of.handlingDays.htmlName}" type="number" min="0" max="30" value="${of.handlingDays.htmlValue}" />
            </div>
            <div class="form-group col-6 col-md-4">
                <label class="form-control-label" for="offer-return-days">${Resource.msg('offer.returndays', 'seller', null)}</label>
                <input class="form-control" id="offer-return-days" name="${of.returnDays.htmlName}" type="number" min="0" max="365" value="${of.returnDays.htmlValue}" />
            </div>
            <div class="form-group col-12 col-md-6 custom-control custom-checkbox form-check">
                <input class="custom-control-input form-check-input" type="checkbox" id="offer-returnable" name="${of.returnable.htmlName}" value="true" <isif condition="${of.returnable.checked}">checked</isif> />
                <label class="custom-control-label form-check-label" for="offer-returnable">${Resource.msg('offer.returnable', 'seller', null)}</label>
            </div>
            <isif condition="${o && (o.status === 'ACTIVE' || o.status === 'INACTIVE')}">
                <div class="form-group col-12 col-md-6">
                    <div class="custom-control custom-checkbox form-check">
                        <input class="custom-control-input form-check-input" type="checkbox" id="offer-active" name="${of.active.htmlName}" value="true" <isif condition="${of.active.checked}">checked</isif> />
                        <label class="custom-control-label form-check-label" for="offer-active">${Resource.msg('offer.active', 'seller', null)}</label>
                    </div>
                </div>
            </isif>
            <div class="form-group col-12">
                <label class="form-control-label" for="offer-warranty">${Resource.msg('offer.warranty', 'seller', null)}</label>
                <input class="form-control" id="offer-warranty" name="${of.warranty.htmlName}" maxlength="500" value="${of.warranty.htmlValue}" />
            </div>
        </div>
        <input type="hidden" name="pid" value="${pdict.pid}" />
        <isif condition="${o}"><input type="hidden" name="revision" value="${o.revision.toFixed(0)}" /></isif>
        <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
        <button class="btn btn-primary" type="submit">${Resource.msg('offer.save', 'seller', null)}</button>
    </form>
</isdecorate>
