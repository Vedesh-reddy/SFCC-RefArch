<isdecorate template="common/layout/page">
    <div class="container seller-central py-4">
        <h1 id="seller-page-title">${Resource.msg('apply.heading', 'seller', null)}</h1>
        <isinclude template="seller/components/flash" />
        <form class="seller-apply-form" action="${URLUtils.url('Seller-SubmitApply')}" method="post">
            <div class="form-group">
                <label class="form-control-label" for="seller-id">${Resource.msg('apply.sellerid', 'seller', null)}</label>
                <input class="form-control" id="seller-id" name="${pdict.applicationForm.sellerId.htmlName}" value="${pdict.applicationForm.sellerId.htmlValue}" required pattern="[A-Za-z0-9][A-Za-z0-9\-]{1,18}[A-Za-z0-9]" maxlength="20" aria-describedby="seller-id-help" />
                <small id="seller-id-help" class="form-text text-muted">${Resource.msg('apply.sellerid.help', 'seller', null)}</small>
            </div>
            <isinclude template="seller/components/business-fields" />
            <div class="form-group">
                <label class="form-control-label" for="seller-categories">${Resource.msg('apply.categories', 'seller', null)}</label>
                <input class="form-control" id="seller-categories" name="${pdict.applicationForm.categories.htmlName}" maxlength="600" value="${pdict.applicationForm.categories.htmlValue}" />
            </div>
            <div class="form-group custom-control custom-checkbox form-check">
                <input class="custom-control-input form-check-input" type="checkbox" id="seller-agreement" name="${pdict.applicationForm.agreementAccepted.htmlName}" value="true" required />
                <label class="custom-control-label form-check-label" for="seller-agreement">${Resource.msgf('apply.agreement', 'seller', null, pdict.agreementVersion)}</label>
                <isif condition="${!empty(pdict.agreementAssetId)}">
                    <a class="d-block small" href="${URLUtils.url('Page-Show', 'cid', pdict.agreementAssetId)}" target="_blank" rel="noopener">${Resource.msg('landing.agreement', 'seller', null)}</a>
                </isif>
            </div>
            <input type="hidden" name="${pdict.applicationForm.agreementVersion.htmlName}" value="${pdict.agreementVersion}" />
            <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
            <button class="btn btn-primary" type="submit">${Resource.msg('apply.submit', 'seller', null)}</button>
        </form>
    </div>
</isdecorate>
