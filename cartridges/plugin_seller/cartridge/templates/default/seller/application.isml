<isdecorate template="seller/components/shell">
    <isscript>
        var s = pdict.seller;
        var editable = (s.status === 'DRAFT' || s.status === 'REJECTED') && pdict.role === 'OWNER';
        // top-level pdict arrays arrive as dw.util.List, hence toArray()
        var requiredText = pdict.requiredTypes.toArray().map(function (t) { return Resource.msg('doctype.' + t, 'seller', t); }).join(', ');
        var missing = (s.emailVerified ? [] : [Resource.msg('problem.email-not-verified', 'seller', null)]).concat(pdict.problems.toArray().map(function (p) {
            return Resource.msgf('problem.missing-document', 'seller', null, Resource.msg('doctype.' + p.split(':')[1], 'seller', p));
        }));
    </isscript>
    <h1 id="seller-page-title">${Resource.msg('application.heading', 'seller', null)}</h1>
    <p>
        ${Resource.msg('application.status', 'seller', null)}:
        <span class="badge badge-info bg-info seller-status">${Resource.msg('status.' + s.status, 'seller', s.status)}</span>
        <isif condition="${!empty(s.statusReason)}"><span class="d-block small">${Resource.msgf('application.reason', 'seller', null, s.statusReason)}</span></isif>
    </p>
    <isif condition="${s.status === 'PENDING_VERIFICATION' || s.status === 'PENDING_APPROVAL'}">
        <p class="alert alert-info" role="status">${Resource.msg('application.submitted', 'seller', null)}</p>
        <p class="small">${Resource.msgf('application.kyc', 'seller', null, s.kycStatus)}</p>
    </isif>

    <section class="card mb-4" aria-labelledby="seller-email-title">
        <div class="card-body">
            <h2 class="h5" id="seller-email-title">${Resource.msg('application.email', 'seller', null)}</h2>
            <isif condition="${s.emailVerified}">
                <p class="mb-0 text-success">${Resource.msg('application.email.verified', 'seller', null)}</p>
            <iselseif condition="${editable}">
                <form class="d-inline-block mr-2 me-2" action="${URLUtils.url('Seller-SendCode')}" method="post">
                    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
                    <button class="btn btn-outline-primary btn-sm" type="submit">${Resource.msg('application.email.send', 'seller', null)}</button>
                </form>
                <form class="form-inline d-inline-flex align-items-end mt-2" action="${URLUtils.url('Seller-VerifyCode')}" method="post">
                    <label class="sr-only visually-hidden" for="seller-code">${Resource.msg('application.email.code', 'seller', null)}</label>
                    <input class="form-control form-control-sm mr-2 me-2" id="seller-code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="\d{6,8}" required placeholder="${Resource.msg('application.email.code', 'seller', null)}" />
                    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
                    <button class="btn btn-primary btn-sm" type="submit">${Resource.msg('application.email.verify', 'seller', null)}</button>
                </form>
            </isif>
        </div>
    </section>

    <section class="card mb-4" aria-labelledby="seller-docs-title">
        <div class="card-body">
            <h2 class="h5" id="seller-docs-title">${Resource.msg('application.documents', 'seller', null)}</h2>
            <isif condition="${pdict.requiredTypes.length > 0}">
                <p class="small">${Resource.msgf('application.documents.required', 'seller', null, requiredText)}</p>
            </isif>
            <isinclude template="seller/components/document-list" />
            <isif condition="${editable}">
                <isinclude template="seller/components/document-upload" />
            </isif>
        </div>
    </section>

    <section class="card mb-4" aria-labelledby="seller-details-title">
        <div class="card-body">
            <h2 class="h5" id="seller-details-title">${Resource.msg('application.details', 'seller', null)}</h2>
            <isif condition="${editable}">
                <form action="${URLUtils.url('Seller-SaveApplication')}" method="post">
                    <isinclude template="seller/components/business-fields" />
                    <input type="hidden" name="revision" value="${s.revision.toFixed(0)}" />
                    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
                    <button class="btn btn-outline-primary" type="submit">${Resource.msg('application.save', 'seller', null)}</button>
                </form>
            <iselse/>
                <dl class="row mb-0">
                    <dt class="col-sm-4">${Resource.msg('apply.displayname', 'seller', null)}</dt><dd class="col-sm-8">${s.displayName}</dd>
                    <dt class="col-sm-4">${Resource.msg('apply.legalname', 'seller', null)}</dt><dd class="col-sm-8">${s.legalName}</dd>
                    <dt class="col-sm-4">${Resource.msg('apply.contactemail', 'seller', null)}</dt><dd class="col-sm-8">${s.contactEmail}</dd>
                </dl>
            </isif>
        </div>
    </section>

    <isif condition="${s.status === 'DRAFT' && pdict.role === 'OWNER'}">
        <isif condition="${missing.length > 0}">
            <p class="small text-muted">${Resource.msgf('application.missing', 'seller', null, missing.join(', '))}</p>
        </isif>
        <form action="${URLUtils.url('Seller-SubmitApplication')}" method="post">
            <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
            <button class="btn btn-primary" type="submit" <isif condition="${missing.length > 0}">disabled</isif>>${Resource.msg('application.submit', 'seller', null)}</button>
        </form>
    </isif>
</isdecorate>
