<isdecorate template="seller/components/shell">
    <isscript>
        var sub = pdict.submission;
        var pf = pdict.productForm;
        var editable = !sub || sub.status === 'DRAFT' || sub.status === 'CHANGES_REQUESTED';
    </isscript>
    <h1 id="seller-page-title">${sub ? Resource.msg('product.heading.edit', 'seller', null) : Resource.msg('product.heading.new', 'seller', null)}</h1>
    <isif condition="${sub}">
        <p>
            <span class="badge badge-info bg-info">${Resource.msg('status.' + sub.status, 'seller', sub.status)}</span>
            <isif condition="${!empty(sub.productId)}"><span class="small text-muted ml-2 ms-2">${sub.productId}</span></isif>
        </p>
        <isif condition="${sub.qualityFlags.length > 0}"><p class="small">${Resource.msgf('product.flags', 'seller', null, sub.qualityFlags.join(', '))}</p></isif>
        <isif condition="${!empty(sub.reviewNotes)}"><p class="alert alert-warning">${Resource.msgf('product.notes', 'seller', null, sub.reviewNotes)}</p></isif>
        <isif condition="${!empty(sub.lastError)}"><p class="small text-danger">${Resource.msgf('product.error', 'seller', null, sub.lastError)}</p></isif>
    </isif>
    <isif condition="${!editable}">
        <p class="text-muted">${Resource.msg('product.readonly', 'seller', null)}</p>
    </isif>
    <form class="seller-product-form" action="${URLUtils.url('Seller-SaveProduct')}" method="post">
        <fieldset <isif condition="${!editable}">disabled</isif>>
            <div class="form-row row">
                <div class="form-group col-12 col-md-6">
                    <label class="form-control-label" for="product-mode">${Resource.msg('product.mode', 'seller', null)}</label>
                    <select class="form-control custom-select" id="product-mode" name="${pf.mode.htmlName}" <isif condition="${sub}">disabled</isif>>
                        <option value="NEW" <isif condition="${pf.mode.htmlValue === 'NEW'}">selected</isif>>${Resource.msg('product.mode.NEW', 'seller', null)}</option>
                        <option value="UPDATE" <isif condition="${pf.mode.htmlValue === 'UPDATE'}">selected</isif>>${Resource.msg('product.mode.UPDATE', 'seller', null)}</option>
                    </select>
                </div>
                <div class="form-group col-12 col-md-6">
                    <label class="form-control-label" for="product-id">${Resource.msg('product.productid', 'seller', null)}</label>
                    <input class="form-control" id="product-id" name="${pf.productId.htmlName}" maxlength="100" value="${pf.productId.htmlValue}" <isif condition="${sub}">disabled</isif> />
                </div>
                <div class="form-group col-12 col-md-6">
                    <label class="form-control-label" for="product-sku">${Resource.msg('product.sku', 'seller', null)}</label>
                    <input class="form-control" id="product-sku" name="${pf.sellerSku.htmlName}" required maxlength="40" value="${pf.sellerSku.htmlValue}" />
                </div>
                <div class="form-group col-12 col-md-6">
                    <label class="form-control-label" for="product-type">${Resource.msg('product.type', 'seller', null)}</label>
                    <select class="form-control custom-select" id="product-type" name="${pf.productType.htmlName}">
                        <option value="SIMPLE" <isif condition="${pf.productType.htmlValue !== 'MASTER'}">selected</isif>>${Resource.msg('product.type.SIMPLE', 'seller', null)}</option>
                        <option value="MASTER" <isif condition="${pf.productType.htmlValue === 'MASTER'}">selected</isif>>${Resource.msg('product.type.MASTER', 'seller', null)}</option>
                    </select>
                </div>
                <div class="form-group col-12">
                    <label class="form-control-label" for="product-name">${Resource.msg('product.name', 'seller', null)}</label>
                    <input class="form-control" id="product-name" name="${pf.name.htmlName}" maxlength="200" value="${pf.name.htmlValue}" />
                </div>
                <div class="form-group col-12">
                    <label class="form-control-label" for="product-short">${Resource.msg('product.short', 'seller', null)}</label>
                    <textarea class="form-control" id="product-short" name="${pf.shortDescription.htmlName}" rows="2" maxlength="1000">${pf.shortDescription.htmlValue}</textarea>
                </div>
                <div class="form-group col-12">
                    <label class="form-control-label" for="product-long">${Resource.msg('product.long', 'seller', null)}</label>
                    <textarea class="form-control" id="product-long" name="${pf.longDescription.htmlName}" rows="4" maxlength="8000">${pf.longDescription.htmlValue}</textarea>
                </div>
                <div class="form-group col-12 col-md-6">
                    <label class="form-control-label" for="product-brand">${Resource.msg('product.brand', 'seller', null)}</label>
                    <input class="form-control" id="product-brand" name="${pf.brand.htmlName}" maxlength="80" value="${pf.brand.htmlValue}" />
                </div>
                <div class="form-group col-12 col-md-6">
                    <label class="form-control-label" for="product-category">${Resource.msg('product.category', 'seller', null)}</label>
                    <select class="form-control custom-select" id="product-category" name="${pf.categoryId.htmlName}">
                        <isloop items="${pdict.categories}" var="categoryId">
                            <option value="${categoryId}" <isif condition="${pf.categoryId.htmlValue === categoryId}">selected</isif>>${categoryId}</option>
                        </isloop>
                    </select>
                </div>
                <div class="form-group col-12 col-md-4">
                    <label class="form-control-label" for="product-gtin">${Resource.msg('product.gtin', 'seller', null)}</label>
                    <input class="form-control" id="product-gtin" name="${pf.gtin.htmlName}" inputmode="numeric" pattern="\d{8}|\d{12,14}" value="${pf.gtin.htmlValue}" />
                </div>
                <div class="form-group col-6 col-md-4">
                    <label class="form-control-label" for="product-price">${Resource.msg('product.price', 'seller', null)}</label>
                    <input class="form-control" id="product-price" name="${pf.price.htmlName}" inputmode="decimal" pattern="\d{1,9}(\.\d{1,2})?" value="${pf.price.htmlValue}" />
                </div>
                <div class="form-group col-6 col-md-4">
                    <label class="form-control-label" for="product-quantity">${Resource.msg('product.quantity', 'seller', null)}</label>
                    <input class="form-control" id="product-quantity" name="${pf.quantity.htmlName}" type="number" min="0" max="100000" value="${pf.quantity.htmlValue}" />
                </div>
                <isif condition="${pdict.taxClasses.length > 0}">
                    <div class="form-group col-12 col-md-4">
                        <label class="form-control-label" for="product-tax">${Resource.msg('product.taxclass', 'seller', null)}</label>
                        <select class="form-control custom-select" id="product-tax" name="${pf.taxClassId.htmlName}">
                            <option value="">${Resource.msg('common.none', 'seller', null)}</option>
                            <isloop items="${pdict.taxClasses}" var="taxClass">
                                <option value="${taxClass}" <isif condition="${pf.taxClassId.htmlValue === taxClass}">selected</isif>>${taxClass}</option>
                            </isloop>
                        </select>
                    </div>
                </isif>
                <div class="form-group col-6 col-md-2">
                    <label class="form-control-label" for="product-weight">${Resource.msg('product.weight', 'seller', null)}</label>
                    <input class="form-control" id="product-weight" name="${pf.weightOz.htmlName}" type="number" min="0" value="${pf.weightOz.htmlValue}" />
                </div>
                <div class="form-group col-6 col-md-2">
                    <label class="form-control-label" for="product-length">${Resource.msg('product.length', 'seller', null)}</label>
                    <input class="form-control" id="product-length" name="${pf.lengthIn.htmlName}" type="number" min="0" value="${pf.lengthIn.htmlValue}" />
                </div>
                <div class="form-group col-6 col-md-2">
                    <label class="form-control-label" for="product-width">${Resource.msg('product.width', 'seller', null)}</label>
                    <input class="form-control" id="product-width" name="${pf.widthIn.htmlName}" type="number" min="0" value="${pf.widthIn.htmlValue}" />
                </div>
                <div class="form-group col-6 col-md-2">
                    <label class="form-control-label" for="product-height">${Resource.msg('product.height', 'seller', null)}</label>
                    <input class="form-control" id="product-height" name="${pf.heightIn.htmlName}" type="number" min="0" value="${pf.heightIn.htmlValue}" />
                </div>
                <div class="form-group col-12">
                    <label class="form-control-label" for="product-specs">${Resource.msg('product.specs', 'seller', null)}</label>
                    <textarea class="form-control" id="product-specs" name="${pf.specifications.htmlName}" rows="4">${pf.specifications.htmlValue}</textarea>
                </div>
                <div class="form-group col-12">
                    <label class="form-control-label" for="product-variants">${Resource.msg('product.variants', 'seller', null)}</label>
                    <textarea class="form-control" id="product-variants" name="${pf.variants.htmlName}" rows="4">${pf.variants.htmlValue}</textarea>
                </div>
                <div class="form-group col-12 col-md-4 custom-control custom-checkbox form-check">
                    <input class="custom-control-input form-check-input" type="checkbox" id="product-returnable" name="${pf.returnable.htmlName}" value="true" <isif condition="${!sub || pf.returnable.checked}">checked</isif> />
                    <label class="custom-control-label form-check-label" for="product-returnable">${Resource.msg('product.returnable', 'seller', null)}</label>
                </div>
                <div class="form-group col-12 col-md-4">
                    <label class="form-control-label" for="product-return-days">${Resource.msg('product.returndays', 'seller', null)}</label>
                    <input class="form-control" id="product-return-days" name="${pf.returnDays.htmlName}" type="number" min="0" max="365" value="${pf.returnDays.htmlValue}" />
                </div>
                <div class="form-group col-12">
                    <label class="form-control-label" for="product-warranty">${Resource.msg('product.warranty', 'seller', null)}</label>
                    <input class="form-control" id="product-warranty" name="${pf.warranty.htmlName}" maxlength="500" value="${pf.warranty.htmlValue}" />
                </div>
                <div class="form-group col-12">
                    <label class="form-control-label" for="product-compliance">${Resource.msg('product.compliance', 'seller', null)}</label>
                    <input class="form-control" id="product-compliance" name="${pf.complianceDocumentIds.htmlName}" value="${pf.complianceDocumentIds.htmlValue}" />
                </div>
            </div>
            <isif condition="${sub}">
                <input type="hidden" name="submissionId" value="${sub.submissionId}" />
                <input type="hidden" name="revision" value="${sub.revision.toFixed(0)}" />
            </isif>
            <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
            <button class="btn btn-outline-primary" type="submit">${Resource.msg('product.save', 'seller', null)}</button>
        </fieldset>
    </form>

    <isif condition="${sub}">
        <section class="card my-4" aria-labelledby="product-images-title">
            <div class="card-body">
                <h2 class="h5" id="product-images-title">${Resource.msg('product.images', 'seller', null)}</h2>
                <ul class="list-inline">
                    <isloop items="${sub.images}" var="image" status="loopState">
                        <li class="list-inline-item mb-2">
                            <span class="badge badge-light bg-light">${(loopState.index + 1).toFixed(0)} &middot; ${image.type}</span>
                            <isif condition="${editable}">
                                <form class="d-inline" action="${URLUtils.url('Seller-RemoveImage')}" method="post">
                                    <input type="hidden" name="submissionId" value="${sub.submissionId}" />
                                    <input type="hidden" name="index" value="${loopState.index.toFixed(0)}" />
                                    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
                                    <button class="btn btn-link btn-sm" type="submit">${Resource.msgf('product.images.remove', 'seller', null, (loopState.index + 1).toFixed(0))}</button>
                                </form>
                            </isif>
                        </li>
                    </isloop>
                </ul>
                <isif condition="${editable}">
                    <form action="${URLUtils.url('Seller-UploadImages')}" method="post" enctype="multipart/form-data">
                        <label class="form-control-label" for="product-image-files">${Resource.msgf('product.images.upload', 'seller', null, pdict.maxImages)}</label>
                        <input class="form-control-file form-control" id="product-image-files" type="file" name="images" accept="image/png,image/jpeg,image/webp" multiple required />
                        <input type="hidden" name="submissionId" value="${sub.submissionId}" />
                        <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
                        <button class="btn btn-outline-primary btn-sm mt-2" type="submit">${Resource.msg('application.document.upload', 'seller', null)}</button>
                    </form>
                </isif>
            </div>
        </section>
        <isif condition="${editable}">
            <form action="${URLUtils.url('Seller-SubmitProduct')}" method="post">
                <input type="hidden" name="submissionId" value="${sub.submissionId}" />
                <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
                <button class="btn btn-primary" type="submit">${Resource.msg('product.submit', 'seller', null)}</button>
            </form>
        </isif>
    </isif>
</isdecorate>
