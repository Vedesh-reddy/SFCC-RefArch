<?xml version="1.0"?>
<form xmlns="http://www.demandware.com/xml/form/2008-04-19" secure="false">
    <field formid="price" type="string" mandatory="true" regexp="^\d{1,9}(\.\d{1,2})?$" missing-error="error.message.required" />
    <field formid="quantity" type="string" mandatory="false" regexp="^\d{1,6}$" />
    <field formid="sellerSku" type="string" mandatory="true" max-length="40" regexp="^[A-Za-z0-9][A-Za-z0-9._-]{0,38}[A-Za-z0-9]$" missing-error="error.message.required" />
    <field formid="condition" type="string" mandatory="false">
        <options>
            <option optionid="NEW" label="offer.condition.NEW" value="NEW" />
            <option optionid="REFURBISHED" label="offer.condition.REFURBISHED" value="REFURBISHED" />
        </options>
    </field>
    <field formid="handlingDays" type="string" mandatory="false" regexp="^\d{1,2}$" />
    <field formid="returnable" type="boolean" mandatory="false" />
    <field formid="returnDays" type="string" mandatory="false" regexp="^\d{1,3}$" />
    <field formid="warranty" type="string" mandatory="false" max-length="500" />
    <field formid="active" type="boolean" mandatory="false" />
</form>
