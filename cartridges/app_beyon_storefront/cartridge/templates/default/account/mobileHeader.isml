<isif condition="${pdict.name === null}">
    <a class="login-btn-mobile" href="${URLUtils.https('Login-Show')}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>${Resource.msg('button.login', 'beyon', null)}</a>
<iselse/>
    <div class="profile-card">
        <img src="${URLUtils.staticURL('/images/beyon/y-mark.png')}" class="watermark" alt="" />
        <div class="profile-name"><isprint value="${customer.profile.firstName + ' ' + customer.profile.lastName}" /></div>
        <isif condition="${customer.profile.phoneHome}">
            <div class="profile-detail"><isprint value="${customer.profile.phoneHome}" /></div>
        </isif>
        <div class="profile-detail"><isprint value="${customer.profile.email}" /></div>
        <button type="button" class="view-profile-btn" id="view-profile-btn" aria-expanded="false" aria-controls="profile-sub-menu">${Resource.msg('button.viewprofile', 'beyon', null)} <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
        <div class="profile-sub-menu" id="profile-sub-menu">
            <a href="${URLUtils.https('Account-EditProfile')}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="1.8" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>${Resource.msg('link.editprofile', 'beyon', null)}</a>
            <a href="${URLUtils.https('Address-List')}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="1.8" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>${Resource.msg('link.address', 'beyon', null)}</a>
            <a href="${URLUtils.https('PaymentInstruments-List')}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="1.8" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>${Resource.msg('link.savedcards', 'beyon', null)}</a>
            <a href="${'#'}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="1.8" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>${Resource.msg('link.neupass', 'beyon', null)}</a>
        </div>
    </div>
    <a class="sign-out-btn" href="${URLUtils.url('Login-Logout')}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>${Resource.msg('button.signout', 'beyon', null)}</a>
</isif>
