<button type="button" class="icon-btn p-0" id="account-btn" aria-haspopup="true" aria-expanded="false" aria-controls="profile-dropdown"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>${Resource.msg('label.account', 'beyon', null)}</span></button>
<div class="profile-dropdown" id="profile-dropdown">
    <div class="dd-profile">
        <isif condition="${pdict.name === null}">
            <div class="dd-guest text-center">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#B0ABAB" stroke-width="1.5" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <div class="dd-guest-title">${Resource.msg('msg.welcome', 'beyon', null)}</div>
                <div class="dd-guest-sub">${Resource.msg('msg.welcome.sub', 'beyon', null)}</div>
                <a class="dd-guest-login" href="${URLUtils.https('Login-Show')}">${Resource.msg('button.login', 'beyon', null)}</a>
            </div>
        <iselse/>
            <img src="${URLUtils.staticURL('/images/beyon/y-mark.png')}" class="watermark" alt="" />
            <div class="dd-name"><isprint value="${customer.profile.firstName + ' ' + customer.profile.lastName}" /></div>
            <isif condition="${customer.profile.phoneHome}">
                <div class="dd-detail"><isprint value="${customer.profile.phoneHome}" /></div>
            </isif>
            <div class="dd-detail"><isprint value="${customer.profile.email}" /></div>
        </isif>
    </div>
    <a href="${URLUtils.https('Account-EditProfile')}" class="dd-link"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>${Resource.msg('link.editprofile', 'beyon', null)}</a>
    <a href="${URLUtils.https('Address-List')}" class="dd-link"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>${Resource.msg('link.address', 'beyon', null)}</a>
    <a href="${URLUtils.https('PaymentInstruments-List')}" class="dd-link"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>${Resource.msg('link.savedcards', 'beyon', null)}</a>
    <a href="${'#'}" class="dd-link"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>${Resource.msg('link.neupass', 'beyon', null)}</a>
    <a href="${URLUtils.https('Order-History')}" class="dd-link"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="3" width="20" height="18" rx="2"/><path d="M8 7h8"/><path d="M8 11h5"/></svg>${Resource.msg('link.orders', 'beyon', null)}</a>
    <isif condition="${pdict.name !== null}">
        <a href="${URLUtils.url('Login-Logout')}" class="dd-signout"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>${Resource.msg('button.signout', 'beyon', null)}</a>
    </isif>
</div>
