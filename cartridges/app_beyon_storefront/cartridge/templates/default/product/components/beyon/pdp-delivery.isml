<div class="pdp-delivery section-delivery-bg">
    <div class="d-flex align-items-center delivery-head">
        <div class="delivery-bar flex-shrink-0"></div>
        <div class="delivery-heading-anim">
            <span class="truck-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 48 48" fill="none" stroke="#d30b39" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="24" height="22" rx="2"/><path d="M28 16h9l7 9v5H28z"/><circle cx="14" cy="38" r="5"/><circle cx="37" cy="38" r="5"/><path d="M39 6L40.2 8.8L43 10L40.2 11.2L39 14L37.8 11.2L35 10L37.8 8.8Z" fill="#B91C1C" stroke="none"/><path d="M6 3L6.9 5.1L9 6L6.9 6.9L6 9L5.1 6.9L3 6L5.1 5.1Z" fill="#B91C1C" stroke="none"/></svg></span>
            <span class="truck-text">${Resource.msg('label.deliverydetails', 'beyon', null)}</span>
        </div>
    </div>
    <div class="pincode-box d-flex align-items-center">
        <div class="position-relative flex-shrink-0">
            <button type="button" class="country-trigger d-flex align-items-center" id="country-trigger" aria-haspopup="listbox" aria-expanded="false">
                <span class="country-trigger-flag" id="country-flag">🇮🇳</span>
                <span class="country-trigger-code" id="country-code">IN</span>
                <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#d30b39" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="country-list d-none" id="country-list" role="listbox">
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start selected" data-code="IN" data-flag="🇮🇳" data-name="India"><span class="country-flag">🇮🇳</span><span class="country-name">India</span><span class="country-code">IN</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="AE" data-flag="🇦🇪" data-name="UAE"><span class="country-flag">🇦🇪</span><span class="country-name">UAE</span><span class="country-code">AE</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="DE" data-flag="🇩🇪" data-name="Germany"><span class="country-flag">🇩🇪</span><span class="country-name">Germany</span><span class="country-code">DE</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="SA" data-flag="🇸🇦" data-name="Saudi Arabia"><span class="country-flag">🇸🇦</span><span class="country-name">Saudi Arabia</span><span class="country-code">SA</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="NL" data-flag="🇳🇱" data-name="Netherlands"><span class="country-flag">🇳🇱</span><span class="country-name">Netherlands</span><span class="country-code">NL</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="MY" data-flag="🇲🇾" data-name="Malaysia"><span class="country-flag">🇲🇾</span><span class="country-name">Malaysia</span><span class="country-code">MY</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="KE" data-flag="🇰🇪" data-name="Kenya"><span class="country-flag">🇰🇪</span><span class="country-name">Kenya</span><span class="country-code">KE</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="RO" data-flag="🇷🇴" data-name="Romania"><span class="country-flag">🇷🇴</span><span class="country-name">Romania</span><span class="country-code">RO</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="ES" data-flag="🇪🇸" data-name="Spain"><span class="country-flag">🇪🇸</span><span class="country-name">Spain</span><span class="country-code">ES</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="PT" data-flag="🇵🇹" data-name="Portugal"><span class="country-flag">🇵🇹</span><span class="country-name">Portugal</span><span class="country-code">PT</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="QA" data-flag="🇶🇦" data-name="Qatar"><span class="country-flag">🇶🇦</span><span class="country-name">Qatar</span><span class="country-code">QA</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="IT" data-flag="🇮🇹" data-name="Italy"><span class="country-flag">🇮🇹</span><span class="country-name">Italy</span><span class="country-code">IT</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="OM" data-flag="🇴🇲" data-name="Oman"><span class="country-flag">🇴🇲</span><span class="country-name">Oman</span><span class="country-code">OM</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="KW" data-flag="🇰🇼" data-name="Kuwait"><span class="country-flag">🇰🇼</span><span class="country-name">Kuwait</span><span class="country-code">KW</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="BH" data-flag="🇧🇭" data-name="Bahrain"><span class="country-flag">🇧🇭</span><span class="country-name">Bahrain</span><span class="country-code">BH</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="ZA" data-flag="🇿🇦" data-name="South Africa"><span class="country-flag">🇿🇦</span><span class="country-name">South Africa</span><span class="country-code">ZA</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="CA" data-flag="🇨🇦" data-name="Canada"><span class="country-flag">🇨🇦</span><span class="country-name">Canada</span><span class="country-code">CA</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="NZ" data-flag="🇳🇿" data-name="New Zealand"><span class="country-flag">🇳🇿</span><span class="country-name">New Zealand</span><span class="country-code">NZ</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="AU" data-flag="🇦🇺" data-name="Australia"><span class="country-flag">🇦🇺</span><span class="country-name">Australia</span><span class="country-code">AU</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="SG" data-flag="🇸🇬" data-name="Singapore"><span class="country-flag">🇸🇬</span><span class="country-name">Singapore</span><span class="country-code">SG</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="US" data-flag="🇺🇸" data-name="USA"><span class="country-flag">🇺🇸</span><span class="country-name">USA</span><span class="country-code">US</span></button>
                    <button type="button" class="country-option d-flex align-items-center w-100 text-start" data-code="GB" data-flag="🇬🇧" data-name="United Kingdom"><span class="country-flag">🇬🇧</span><span class="country-name">United Kingdom</span><span class="country-code">GB</span></button>
            </div>
        </div>
        <input type="tel" maxlength="6" class="pincode-input flex-grow-1" id="pincode-input" placeholder="${Resource.msg('label.pincode', 'beyon', null)}" aria-label="${Resource.msg('label.pincode', 'beyon', null)}" />
        <div class="pincode-action flex-shrink-0">
            <button type="button" class="pincode-check" id="pincode-check">${Resource.msg('button.check', 'beyon', null)}</button>
        </div>
    </div>
    <div class="pincode-result pincode-ok d-none align-items-center" id="pincode-ok">
        <svg aria-hidden="true" width="14" height="14" fill="none" stroke="#2E7D32" stroke-width="2.5" stroke-linecap="round"><path d="M3 7l3.5 3.5L13 4"/></svg>
        <p>${Resource.msg('msg.deliveryto', 'beyon', null)} <strong id="pincode-ok-country"></strong> ${Resource.msg('msg.expectedby', 'beyon', null)} <strong id="pincode-ok-date"></strong></p>
    </div>
    <div class="pincode-result pincode-bad d-none align-items-center" id="pincode-bad">
        <svg aria-hidden="true" width="14" height="14" fill="none" stroke="#BF0E23" stroke-width="2" stroke-linecap="round"><circle cx="7" cy="7" r="6"/><line x1="5" y1="5" x2="9" y2="9"/><line x1="9" y1="5" x2="5" y2="9"/></svg>
        <p>${Resource.msg('msg.nodelivery', 'beyon', null)} <strong id="pincode-bad-value"></strong></p>
    </div>
    <div class="delivery-estimate d-flex align-items-start" id="delivery-estimate">
        <svg class="flex-shrink-0" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="#d30b39" stroke="none"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        <p>${Resource.msg('msg.deliveryestimate', 'beyon', null)}</p>
    </div>
    <div class="trust-row d-flex">
        <div class="trust-badge d-flex flex-column align-items-center text-center"><span class="trust-icon d-flex align-items-center justify-content-center trust-anim-0"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 48 48" fill="none" stroke="#d30b39" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 15a15 15 0 0 1 22-9"/><path d="M39 33a15 15 0 0 1-22 9"/><path d="M27 4l4 2-2 4"/><path d="M21 44l-4-2 2-4"/><rect x="15" y="20" width="18" height="16" rx="2"/><path d="M15 25h18M20 18v4M28 18v4"/><text x="24" y="32" font-size="7" font-weight="700" text-anchor="middle" fill="#d30b39" stroke="none" font-family="Geom, sans-serif">7</text><path d="M8 5L9.2 7.8L12 9L9.2 10.2L8 13L6.8 10.2L4 9L6.8 7.8Z" fill="#B91C1C" stroke="none"/><path d="M41 37L41.9 39.1L44 40L41.9 40.9L41 43L40.1 40.9L38 40L40.1 39.1Z" fill="#B91C1C" stroke="none"/></svg></span><span class="trust-label">7 Days Free Returns</span></div>
        <div class="trust-badge d-flex flex-column align-items-center text-center"><span class="trust-icon d-flex align-items-center justify-content-center trust-anim-1"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 48 48" fill="none" stroke="#d30b39" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="14" width="24" height="18" rx="2"/><path d="M28 20h8l6 7v5H28z"/><circle cx="14" cy="36" r="4.5"/><circle cx="34" cy="36" r="4.5"/><path d="M4 20h18M4 26h14"/><path d="M39 6L40.2 8.8L43 10L40.2 11.2L39 14L37.8 11.2L35 10L37.8 8.8Z" fill="#B91C1C" stroke="none"/><path d="M6 5L6.9 7.1L9 8L6.9 8.9L6 11L5.1 8.9L3 8L5.1 7.1Z" fill="#B91C1C" stroke="none"/></svg></span><span class="trust-label">Free Shipping in India</span></div>
        <div class="trust-badge d-flex flex-column align-items-center text-center"><span class="trust-icon d-flex align-items-center justify-content-center trust-anim-2"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 48 48" fill="none" stroke="#d30b39" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 42h36M8 42V18l16-10 16 10v24"/><path d="M19 42V27h10v15"/><path d="M19 27l5-6 5 6"/><path d="M38 5L39.2 7.8L42 9L39.2 10.2L38 13L36.8 10.2L34 9L36.8 7.8Z" fill="#B91C1C" stroke="none"/><path d="M8 4L8.9 6.1L11 7L8.9 7.9L8 10L7.1 7.9L5 7L7.1 6.1Z" fill="#B91C1C" stroke="none"/></svg></span><span class="trust-label">From<br/>HOUSE OF TITAN</span></div>
        <div class="trust-badge d-flex flex-column align-items-center text-center"><span class="trust-icon d-flex align-items-center justify-content-center trust-anim-3"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 48 48" fill="none" stroke="#d30b39" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13,6 21,16 13,26 5,16"/><polygon points="28,18 42,18 42,30 28,30"/><path d="M18 12a16 16 0 0 1 16-3"/><path d="M14 8l4 1-1 4"/><path d="M30 36a16 16 0 0 1-16 3"/><path d="M34 40l-4-1 1-4"/><path d="M8 4.5L9.05 6.95L11.5 8L9.05 9.05L8 11.5L6.95 9.05L4.5 8L6.95 6.95Z" fill="#B91C1C" stroke="none"/><path d="M40 7L40.9 9.1L43 10L40.9 10.9L40 13L39.1 10.9L37 10L39.1 9.1Z" fill="#B91C1C" stroke="none"/></svg></span><span class="trust-label">Lifetime Gold Exchange*</span></div>
        <div class="trust-badge d-flex flex-column align-items-center text-center"><span class="trust-icon d-flex align-items-center justify-content-center trust-anim-4"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 48 48" fill="none" stroke="#d30b39" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M24 4l16 6v12c0 12-7 19-16 22-9-3-16-10-16-22V10z"/><path d="M16 24l6 6 11-13"/><path d="M39 4L40.2 6.8L43 8L40.2 9.2L39 12L37.8 9.2L35 8L37.8 6.8Z" fill="#B91C1C" stroke="none"/><path d="M6 33L6.9 35.1L9 36L6.9 36.9L6 39L5.1 36.9L3 36L5.1 35.1Z" fill="#B91C1C" stroke="none"/></svg></span><span class="trust-label">Secure Payments<br/>TATA TRUST</span></div>
    </div>
</div>
