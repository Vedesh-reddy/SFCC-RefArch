<div class="pdp-gallery-desktop d-flex flex-wrap">
    <isloop items="${product.images.large}" var="image" status="imageState" end="3">
        <div class="desktop-cell position-relative" role="button" tabindex="0" data-lightbox-index="${imageState.index.toFixed(0)}" aria-label="${image.alt}">
            <img class="desktop-image w-100 h-100" src="${image.url}" alt="${image.alt}" draggable="false" loading="lazy" />
            <isif condition="${imageState.first}">
                <span class="ribbon ribbon-red">${Resource.msg('ribbon.sellingfast', 'beyon', null)}</span>
            </isif>
            <isif condition="${imageState.index === 1}">
                <button type="button" class="stack-btn stack-btn-desktop js-stack d-flex align-items-center"><svg aria-hidden="true" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#3c3c3c" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg><span>${Resource.msg('label.stackit', 'beyon', null)}</span></button>
            </isif>
            <div class="zoom-hint d-flex align-items-center justify-content-center"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3c3c3c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg></div>
        </div>
    </isloop>
</div>
