<iscomment>Ribbons, the offer tag and the fourth card's request state are design placeholders keyed on grid position.</iscomment>
<isset name="tileIndex" value="${request.httpParameterMap.beyonIndex.intValue}" scope="page" />
<isset name="tilePrice" value="${product.price}" scope="page" />
<isset name="tileSales" value="${tilePrice.type === 'range' ? tilePrice.min.sales : tilePrice.sales}" scope="page" />
<isset name="tileList" value="${tilePrice.type === 'range' ? null : tilePrice.list}" scope="page" />
<isset name="onRequest" value="${tileIndex === 3}" scope="page" />
<isset name="showOffer" value="${tileIndex % 4 === 0 && !onRequest}" scope="page" />
<isset name="ribbonKey" value="${tileIndex === 0 || tileIndex === 8 ? 'sellingfast' : (tileIndex === 2 || tileIndex === 11 ? 'justdropped' : (tileIndex === 5 || tileIndex === 14 ? 'stackable' : ''))}" scope="page" />
<isset name="tilePriceText" value="${tileSales && tileSales.formatted ? tileSales.formatted : ''}" scope="page" />
<div class="product-card d-flex flex-column" data-pid="${product.id}" data-index="${tileIndex.toFixed(0)}" data-price="${tileSales && tileSales.decimalPrice ? tileSales.decimalPrice : 0}" data-price-text="${tilePriceText}">
    <div class="img-wrap">
        <isif condition="${!empty(ribbonKey)}">
            <span class="ribbon ribbon-${ribbonKey}">${Resource.msg('ribbon.' + ribbonKey, 'beyon', null)}</span>
        </isif>
        <a class="d-block h-100" href="${pdict.urls.product}" tabindex="-1" aria-hidden="true"><img class="w-100 h-100 ${onRequest ? 'is-on-request' : ''}" src="${product.images.medium[0].url}" alt="${product.productName}" loading="lazy" /></a>
        <button type="button" class="wishlist-btn p-0" data-pid="${product.id}" aria-pressed="false" aria-label="${Resource.msgf('button.wishlist', 'beyon', null, product.productName)}"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/></svg></button>
    </div>
    <div class="card-body-wrap d-flex flex-column flex-grow-1">
        <div class="d-flex align-items-start justify-content-between card-top">
            <a class="card-name flex-grow-1" href="${pdict.urls.product}">${product.productName}</a>
            <isif condition="${!onRequest}">
                <button type="button" class="card-bag p-0 flex-shrink-0 position-relative d-flex align-items-center justify-content-center js-open-size" aria-label="${Resource.msg('plp.addtobag', 'beyon', null)}"><svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#2C2C2C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg><span class="card-bag-plus d-flex align-items-center justify-content-center"><svg aria-hidden="true" width="7" height="7" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span></button>
            </isif>
        </div>
        <div class="card-price-area">
            <isif condition="${onRequest}">
                <button type="button" class="card-request d-flex align-items-center justify-content-center w-100 js-open-request"><svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#2C2C2C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>${Resource.msg('button.requestdesign', 'beyon', null)}</button>
            <iselse/>
                <div class="d-flex align-items-center flex-wrap card-prices"><span class="card-price">${tilePriceText}</span><isif condition="${tileList}"><span class="card-mrp">${tileList.formatted}</span></isif></div>
                <isif condition="${tilePriceText && (tileList || showOffer)}">
                    <div class="card-offer d-flex align-items-center"><svg aria-hidden="true" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#BF0E23" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg><span>${Resource.msg('label.offer', 'beyon', null)}</span></div>
                </isif>
            </isif>
        </div>
    </div>
</div>
