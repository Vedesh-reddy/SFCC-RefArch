<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets');
        assets.addJs('/js/beyon-pdp.js');
        assets.addCss('/css/product/detail.css');

        var pdpSales = pdict.product.price.type === 'range' ? pdict.product.price.min.sales : pdict.product.price.sales;
        var pdpList = pdict.product.price.type === 'range' ? null : pdict.product.price.list;
        var variationAttributes = pdict.product.variationAttributes || [];
        var findAttribute = function (id) {
            return variationAttributes.filter(function (attr) {
                return attr.id === id;
            })[0] || null;
        };
        var pdpImageData = JSON.stringify(pdict.product.images.large.map(function (image) {
            return { url: image.url, alt: image.alt };
        }));
        var savedMoney = pdpList && pdpSales ? new dw.value.Money(pdpList.value - pdpSales.value, pdpSales.currency) : null;
        var previewState = request.httpParameterMap.preview.stringValue;
        var previewMetals = {
            rose14: { label: 'spec.metal.rose14', shine: 'metal-text-shine-rose' },
            white14: { label: 'spec.metal.white14', shine: 'metal-text-shine-silver' },
            silver925: { label: 'spec.metal.silver925', shine: 'metal-text-shine-silver' }
        };
        var metal = previewMetals[previewState] || { label: 'spec.metal', shine: 'metal-text-shine-gold' };
    </isscript>

    <isset name="product" value="${pdict.product}" scope="page" />
    <isset name="sizeAttr" value="${findAttribute('size')}" scope="page" />
    <isset name="colorAttr" value="${findAttribute('color')}" scope="page" />
    <isset name="isOutOfStock" value="${!product.available || previewState === 'oos'}" scope="page" />
    <isset name="hasCustomisation" value="${isOutOfStock || previewState === 'withcustom'}" scope="page" />
    <isset name="noOffer" value="${previewState === 'nooffer'}" scope="page" />
    <isset name="metalLabel" value="${Resource.msg(metal.label, 'beyon', null)}" scope="page" />
    <isset name="metalShine" value="${metal.shine}" scope="page" />
    <isset name="salesPrice" value="${pdpSales && pdpSales.formatted ? pdpSales.formatted : ''}" scope="page" />
    <isset name="listPrice" value="${pdpList && pdpList.formatted ? pdpList.formatted : ''}" scope="page" />
    <isset name="savedAmount" value="${savedMoney ? dw.util.StringUtils.formatMoney(savedMoney) : ''}" scope="page" />

    <isobject object="${product.raw}" view="detail">
        <div class="beyon-pdp ${isOutOfStock ? 'is-oos' : ''}" id="beyon-pdp"
             data-pid="${product.id}"
             data-ready="${product.readyToOrder ? 'true' : 'false'}"
             data-add-url="${pdict.addToCartUrl}"
             data-cart-url="${URLUtils.https('Cart-Show')}"
             data-images="${pdpImageData}"
             data-msg-added="${Resource.msg('msg.addedtobag', 'beyon', null)}"
             data-msg-copied="${Resource.msg('msg.linkcopied', 'beyon', null)}"
             data-msg-select="${Resource.msg('msg.selectoptions', 'beyon', null)}"
             data-msg-failed="${Resource.msg('msg.addfailed', 'beyon', null)}"
             data-msg-gotobag="${Resource.msg('button.gotobag', 'beyon', null)}"
             data-msg-checkout="${Resource.msg('msg.checkout', 'beyon', null)}"
             data-msg-coupon="${Resource.msg('msg.couponcopied', 'beyon', null)}"
             data-preview="${previewState || ''}">
            <isinclude template="product/components/beyon/pdp-app-banner" />
            <div class="pdp-shell">
                <div class="pdp-main pdp-container">
                    <div class="pdp-gallery-col">
                        <isinclude template="product/components/beyon/pdp-gallery" />
                        <isinclude template="product/components/beyon/pdp-gallery-desktop" />
                    </div>
                    <div class="pdp-side">
                        <div class="pdp-panel-header"><isinclude template="product/components/beyon/pdp-header" /></div>
                        <div class="pdp-panel pdp-panel-info"><isinclude template="product/components/beyon/pdp-info" /></div>
                        <div class="pdp-coupons"><isinclude template="product/components/beyon/pdp-coupons" /></div>
                        <isif condition="${!isOutOfStock}">
                            <div class="pdp-panel pdp-panel-bordered"><isinclude template="product/components/beyon/pdp-delivery" /></div>
                        </isif>
                        <div class="pdp-panel pdp-panel-bordered pdp-panel-customise"><isinclude template="product/components/beyon/pdp-customise" /></div>
                        <isinclude template="product/components/beyon/pdp-extras" />
                    </div>
                </div>
                <div class="brand-image"><img class="w-100 h-100 d-block" src="${URLUtils.staticURL('/images/beyon/pdp/horizontal-banner.png')}" alt="${Resource.msg('label.logo', 'beyon', null)}" loading="lazy" /></div>
                <div class="pdp-container"><isinclude template="product/components/beyon/pdp-reviews" /></div>
                <div class="pdp-container"><isinclude template="product/components/beyon/pdp-stack" /></div>
                <div class="pdp-container"><isinclude template="product/components/beyon/pdp-faq" /></div>
                <div class="pdp-spacer"></div>
            </div>
            <isinclude template="product/components/beyon/pdp-bars" />
            <isinclude template="product/components/beyon/pdp-modals" />
        </div>
    </isobject>
</isdecorate>
