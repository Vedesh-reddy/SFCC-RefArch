<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets');
        assets.addJs('/js/beyon-plp.js');
        assets.addCss('/css/search.css');
    </isscript>

    <isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
        <isinclude template="reporting/reportingUrls" />
    </isif>

    <isset name="beyonTitle" value="${pdict.productSearch.isCategorySearch && pdict.productSearch.category.id !== 'root' ? pdict.productSearch.category.name : Resource.msg('label.allcollections', 'beyon', null)}" scope="page" />
    <div class="pdp-toast" id="plp-toast" role="status"></div>
    <main class="beyon-plp" id="beyon-plp"
          data-total="${pdict.productSearch.count.toFixed(0)}"
          data-showing-template="${Resource.msg('label.showing', 'beyon', null)}"
          data-msg-wishlisted="${Resource.msg('label.wishlisted', 'beyon', null)}"
          data-msg-added="${Resource.msg('plp.addedtobag', 'beyon', null)}"
          data-msg-request="${Resource.msg('plp.requestdone', 'beyon', null)}">
        <div class="plp-mobile-head">
            <isinclude template="search/components/beyon-crumbs" />
            <div class="d-flex align-items-center justify-content-between plp-mobile-title">
                <h1 class="plp-title-mobile"><isprint value="${beyonTitle}" /> <span class="plp-count-mobile">(${pdict.productSearch.count.toFixed(0)})</span></h1>
                <div class="sort-pill d-flex align-items-center">
                    <button type="button" class="sort-pill-btn p-0 js-open-filters" aria-label="${Resource.msg('label.filters', 'beyon', null)}" aria-haspopup="dialog"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2C2C2C" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/><circle cx="9" cy="7" r="1.6" fill="#2C2C2C" stroke="none"/><circle cx="15" cy="12" r="1.6" fill="#2C2C2C" stroke="none"/><circle cx="9" cy="17" r="1.6" fill="#2C2C2C" stroke="none"/></svg></button>
                    <span class="sort-pill-line"></span>
                    <button type="button" class="sort-pill-btn sort-pill-label d-flex align-items-center p-0 js-open-sort" aria-haspopup="dialog"><span id="sort-label-mobile">${Resource.msg('plp.bestmatches', 'beyon', null)}</span><svg aria-hidden="true" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#2C2C2C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button>
                </div>
            </div>
        </div>
        <div class="active-filters d-none flex-wrap" id="active-filters" data-clear-label="${Resource.msg('button.clear', 'beyon', null)}"></div>

        <div class="plp-layout">
            <aside class="plp-sidebar" aria-label="${Resource.msg('label.filters', 'beyon', null)}">
                <isinclude template="search/components/beyon-crumbs" />
                <h1 class="plp-title"><isprint value="${beyonTitle}" /></h1>
                <p class="plp-count">${pdict.productSearch.count.toFixed(0)} ${Resource.msg('plp.items', 'beyon', null)}</p>
                <select class="sort-select w-100" id="sort-select" aria-label="${Resource.msg('label.sort', 'beyon', null)}">
                        <option value="best-matches">${Resource.msg('plp.sortby', 'beyon', null)} Best-Matches</option>
                        <option value="new-arrivals">${Resource.msg('plp.sortby', 'beyon', null)} New Arrivals</option>
                        <option value="best-sellers">${Resource.msg('plp.sortby', 'beyon', null)} Best Sellers</option>
                        <option value="popularity">${Resource.msg('plp.sortby', 'beyon', null)} Popularity</option>
                        <option value="price-low">${Resource.msg('plp.sortby', 'beyon', null)} Price (Low To High)</option>
                        <option value="price-high">${Resource.msg('plp.sortby', 'beyon', null)} Price (High To Low)</option>
                        <option value="discount">${Resource.msg('plp.sortby', 'beyon', null)} Discount</option>
                </select>
                <div class="d-flex align-items-center justify-content-between filter-head">
                    <h2 class="filter-title">${Resource.msg('plp.filterby', 'beyon', null)}</h2>
                    <button type="button" class="clear-all p-0 js-clear-filters">${Resource.msg('button.clearall', 'beyon', null)}</button>
                </div>
                <isinclude template="search/components/beyon-filter-groups" />
            </aside>

            <div class="plp-content">
                <isset name="promoBannerImage" value="${URLUtils.staticURL('/images/beyon/pdp/pd-1.webp')}" scope="page" />
                <isinclude template="components/beyon-promo-banner" />

                <div class="plp-loader" id="plp-loader" aria-hidden="true"><span></span><span></span><span></span></div>
                <isif condition="${pdict.productSearch.productIds.length > 0}">
                    <div class="product-grid d-flex flex-wrap pt-0" id="product-grid">
                        <isinclude template="search/productGrid" />
                    </div>
                </isif>
                <div class="plp-empty flex-column align-items-center text-center ${pdict.productSearch.productIds.length > 0 ? 'd-none' : 'd-flex'}" id="plp-empty">
                    <isinclude template="search/components/beyon-cat-sketch" />
                    <h3 class="plp-empty-title">${Resource.msg('plp.empty.title', 'beyon', null)}</h3>
                    <p class="plp-empty-text">${Resource.msg('plp.empty.text', 'beyon', null)}</p>
                    <button type="button" class="plp-empty-btn js-clear-filters">${Resource.msg('plp.empty.cta', 'beyon', null)}</button>
                </div>
            </div>
        </div>
    </main>

    <div class="plp-overlay" id="filter-overlay"></div>
    <div class="plp-sheet" id="filter-sheet" role="dialog" aria-modal="true" aria-labelledby="filter-sheet-title">
        <div class="sheet-inner">
            <div class="sheet-handle sheet-handle-mobile"></div>
            <div class="d-flex align-items-center justify-content-between sheet-head">
                <h3 class="sheet-title" id="filter-sheet-title">${Resource.msg('plp.filterby', 'beyon', null)}</h3>
                <button type="button" class="sheet-close p-0 js-close-filters" aria-label="${Resource.msg('button.close', 'beyon', null)}"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3c3c3c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
            </div>
            <div class="sheet-facets"><isinclude template="search/components/beyon-filter-groups" /></div>
            <div class="d-flex sheet-actions">
                <button type="button" class="sheet-btn-clear js-clear-filters">${Resource.msg('button.clearall', 'beyon', null)}</button>
                <button type="button" class="sheet-btn-apply js-close-filters">${Resource.msg('button.apply', 'beyon', null)}</button>
            </div>
        </div>
    </div>

    <div class="plp-overlay" id="sort-overlay"></div>
    <div class="plp-sheet plp-sheet-sort" id="sort-sheet" role="dialog" aria-modal="true" aria-labelledby="sort-sheet-title">
        <div class="sheet-inner">
            <div class="sheet-handle"></div>
            <h3 class="sheet-title sheet-title-sort" id="sort-sheet-title">${Resource.msg('plp.sorttitle', 'beyon', null)}</h3>
            <div class="sort-options">
                    <button type="button" class="sort-option active w-100 text-left" data-sort="best-matches">Best-Matches</button>
                    <button type="button" class="sort-option w-100 text-left" data-sort="new-arrivals">New Arrivals</button>
                    <button type="button" class="sort-option w-100 text-left" data-sort="best-sellers">Best Sellers</button>
                    <button type="button" class="sort-option w-100 text-left" data-sort="popularity">Popularity</button>
                    <button type="button" class="sort-option w-100 text-left" data-sort="price-low">Price (Low To High)</button>
                    <button type="button" class="sort-option w-100 text-left" data-sort="price-high">Price (High To Low)</button>
                    <button type="button" class="sort-option w-100 text-left" data-sort="discount">Discount</button>
            </div>
        </div>
    </div>

    <div class="size-overlay" id="size-overlay"></div>
    <div class="size-modal" id="size-modal" role="dialog" aria-modal="true" aria-labelledby="size-modal-title">
        <div class="size-modal-inner h-100 d-flex flex-column">
            <div class="d-flex align-items-center justify-content-between size-modal-head">
                <h3 class="size-modal-title" id="size-modal-title">${Resource.msg('plp.selectsize', 'beyon', null)}</h3>
                <button type="button" class="size-modal-close p-0" id="size-close" aria-label="${Resource.msg('button.close', 'beyon', null)}"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
            </div>
            <div class="d-flex flex-wrap size-options" id="size-options">
                <button type="button" class="size-pill selected">17.20 MM</button>
                <button type="button" class="size-pill">16.80 MM</button>
                <button type="button" class="size-pill">16.40 MM</button>
            </div>
            <div class="size-modal-foot">
                <div class="text-right size-guide-row"><a class="size-guide-link" href="${'#'}">${Resource.msg('plp.sizeguide', 'beyon', null)}</a></div>
                <div class="d-flex align-items-center justify-content-between size-total"><span class="size-total-label">${Resource.msg('plp.totalprice', 'beyon', null)}</span><span class="size-total-value" id="size-total-price"></span></div>
                <button type="button" class="size-confirm w-100" id="size-confirm">${Resource.msg('plp.confirmadd', 'beyon', null)}</button>
            </div>
        </div>
    </div>

    <div class="rd-overlay d-none" id="request-popup" role="dialog" aria-modal="true" aria-labelledby="request-popup-title">
        <div class="rd-modal">
            <div class="d-flex align-items-center justify-content-between rd-head">
                <div><h3 class="rd-title" id="request-popup-title">${Resource.msg('form.request.title', 'beyon', null)}</h3><p class="rd-sub">${Resource.msg('form.request.sub', 'beyon', null)}</p></div>
                <button type="button" class="sheet-close flex-shrink-0 p-0 js-request-close" aria-label="${Resource.msg('button.close', 'beyon', null)}"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3c3c3c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
            </div>
            <form id="request-form" novalidate>
                <div class="rd-fields">
                    <div><input type="text" class="rd-input w-100" placeholder="${Resource.msg('form.name', 'beyon', null)}" aria-label="${Resource.msg('form.name', 'beyon', null)}" autocomplete="name" data-required="true" /><p class="rd-error">${Resource.msg('form.name.error', 'beyon', null)}</p></div>
                    <div><input type="email" class="rd-input w-100" placeholder="${Resource.msg('form.email', 'beyon', null)}" aria-label="${Resource.msg('form.email', 'beyon', null)}" autocomplete="email" data-required="email" /><p class="rd-error">${Resource.msg('form.email.error', 'beyon', null)}</p></div>
                    <div>
                        <div class="d-flex rd-phone-row"><select class="rd-input rd-country flex-shrink-0" aria-label="${Resource.msg('form.countrycode', 'beyon', null)}"><option value="+91">🇮🇳 +91</option><option value="+1">🇺🇸 +1</option><option value="+44">🇬🇧 +44</option><option value="+971">🇦🇪 +971</option></select><div class="flex-grow-1"><input type="tel" class="rd-input w-100" placeholder="${Resource.msg('form.phone', 'beyon', null)}" aria-label="${Resource.msg('form.phone', 'beyon', null)}" maxlength="10" autocomplete="tel" data-required="phone" /></div></div>
                        <p class="rd-error">${Resource.msg('form.phone.error', 'beyon', null)}</p>
                    </div>
                    <div><input type="text" class="rd-input w-100" placeholder="${Resource.msg('form.city', 'beyon', null)}" aria-label="${Resource.msg('form.city', 'beyon', null)}" autocomplete="address-level2" data-required="true" /><p class="rd-error">${Resource.msg('form.city.error', 'beyon', null)}</p></div>
                </div>
                <button type="submit" class="rd-submit w-100">${Resource.msg('button.submitrequest', 'beyon', null)}</button>
            </form>
            <p class="rd-terms text-center">${Resource.msg('form.request.terms', 'beyon', null)}</p>
        </div>
    </div>
</isdecorate>
