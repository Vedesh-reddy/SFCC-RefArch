<div class="drawer-inner">
<div class="drawer-handle"></div>
<div class="drawer-head d-flex align-items-center justify-content-between">
  <h2 class="drawer-title" id="filter-drawer-title">${Resource.msg('label.refineby', 'beyon', null)}</h2>
  <button type="button" class="drawer-close" id="filter-close" aria-label="${Resource.msg('button.close', 'beyon', null)}">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2C2C2C" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
</div>

<!-- Price Range -->
<div class="facet-head d-flex align-items-center">
  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B0ABAB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
  <p class="facet-title">Price Range</p>
</div>
<div class="facet-chips d-flex flex-wrap">
  <button type="button" class="filter-chip" data-filter="price" data-val="under-10k" aria-pressed="false">Under ₹10,000</button>
  <button type="button" class="filter-chip" data-filter="price" data-val="10k-25k" aria-pressed="false">₹10K – ₹25K</button>
  <button type="button" class="filter-chip" data-filter="price" data-val="25k-50k" aria-pressed="false">₹25K – ₹50K</button>
  <button type="button" class="filter-chip" data-filter="price" data-val="50k-1l" aria-pressed="false">₹50K – ₹1L</button>
  <button type="button" class="filter-chip" data-filter="price" data-val="1l-2l" aria-pressed="false">₹1L – ₹2L</button>
  <button type="button" class="filter-chip" data-filter="price" data-val="2l-plus" aria-pressed="false">₹2L+</button>
</div>

<!-- Jewellery Type -->
<div class="facet-head d-flex align-items-center">
  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B0ABAB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
  <p class="facet-title">Jewellery Type</p>
</div>
<div class="facet-chips d-flex flex-wrap">
  <button type="button" class="filter-chip" data-filter="jtype" data-val="gold" aria-pressed="false">Gold Jewellery</button>
  <button type="button" class="filter-chip" data-filter="jtype" data-val="silver" aria-pressed="false">Silver Jewellery</button>
</div>

<!-- Category -->
<div class="facet-head d-flex align-items-center">
  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B0ABAB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
  <p class="facet-title">Category</p>
</div>
<div class="facet-chips d-flex flex-wrap">
  <button type="button" class="filter-chip" data-filter="cat" data-val="bangle" aria-pressed="false">Bangle</button>
  <button type="button" class="filter-chip" data-filter="cat" data-val="bracelet" aria-pressed="false">Bracelet</button>
  <button type="button" class="filter-chip" data-filter="cat" data-val="earrings" aria-pressed="false">Earrings</button>
  <button type="button" class="filter-chip" data-filter="cat" data-val="finger-ring" aria-pressed="false">Finger Ring</button>
  <button type="button" class="filter-chip" data-filter="cat" data-val="mangalsutra" aria-pressed="false">Mangalsutra</button>
  <button type="button" class="filter-chip" data-filter="cat" data-val="necklace" aria-pressed="false">Necklace</button>
  <button type="button" class="filter-chip" data-filter="cat" data-val="necklace-set" aria-pressed="false">Necklace Set</button>
  <button type="button" class="filter-chip" data-filter="cat" data-val="nose-pin" aria-pressed="false">Nose Pin</button>
  <button type="button" class="filter-chip" data-filter="cat" data-val="pendant" aria-pressed="false">Pendant</button>
  <button type="button" class="filter-chip" data-filter="cat" data-val="pendant-earrings-set" aria-pressed="false">Pendant and Earrings Set</button>
  <button type="button" class="filter-chip" data-filter="cat" data-val="pendant-chain" aria-pressed="false">Pendant With Chain</button>
</div>

<!-- Diamond Carat -->
<div class="facet-head d-flex align-items-center">
  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B0ABAB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M2 9h20"/><path d="M10 3l-4 6 6 13 6-13-4-6"/></svg>
  <p class="facet-title">Diamond Carat</p>
</div>
<div class="facet-chips d-flex flex-wrap">
  <button type="button" class="filter-chip" data-filter="carat" data-val="under-030" aria-pressed="false">Under 0.30 carat</button>
  <button type="button" class="filter-chip" data-filter="carat" data-val="030-050" aria-pressed="false">0.30 – 0.50 carat</button>
  <button type="button" class="filter-chip" data-filter="carat" data-val="050-1" aria-pressed="false">0.50 – 1 carat</button>
  <button type="button" class="filter-chip" data-filter="carat" data-val="1-2" aria-pressed="false">1 – 2 carat</button>
  <button type="button" class="filter-chip" data-filter="carat" data-val="2-3" aria-pressed="false">2 – 3 carat</button>
  <button type="button" class="filter-chip" data-filter="carat" data-val="3-plus" aria-pressed="false">3 carat and above</button>
</div>

<!-- Shop For -->
<div class="facet-head d-flex align-items-center">
  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B0ABAB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
  <p class="facet-title">Shop For</p>
</div>
<div class="facet-chips d-flex flex-wrap">
  <button type="button" class="filter-chip" data-filter="gender" data-val="men" aria-pressed="false">Men</button>
  <button type="button" class="filter-chip" data-filter="gender" data-val="women" aria-pressed="false">Women</button>
</div>

<!-- Gold Karat -->
<div class="facet-head d-flex align-items-center">
  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B0ABAB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
  <p class="facet-title">Gold Karat</p>
</div>
<div class="facet-chips d-flex flex-wrap">
  <button type="button" class="filter-chip" data-filter="karat" data-val="9kt" aria-pressed="false">9KT</button>
  <button type="button" class="filter-chip" data-filter="karat" data-val="14kt" aria-pressed="false">14KT</button>
  <button type="button" class="filter-chip" data-filter="karat" data-val="18kt" aria-pressed="false">18KT</button>
</div>

<!-- Metal Colour -->
<div class="facet-head d-flex align-items-center">
  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B0ABAB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="10.5" r="2.5"/><circle cx="8.5" cy="7.5" r="2.5"/><circle cx="6.5" cy="12.5" r="2.5"/><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12a10 10 0 005.012 8.662"/></svg>
  <p class="facet-title">Metal Colour</p>
</div>
<div class="facet-chips d-flex flex-wrap">
  <button type="button" class="filter-chip" data-filter="mcolor" data-val="rose" aria-pressed="false">Rose</button>
  <button type="button" class="filter-chip" data-filter="mcolor" data-val="yellow" aria-pressed="false">Yellow</button>
  <button type="button" class="filter-chip" data-filter="mcolor" data-val="white" aria-pressed="false">White</button>
</div>

<!-- Size -->
<div class="facet-head d-flex align-items-center">
  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B0ABAB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 3H3v18h18V3z"/><path d="M3 9h4"/><path d="M3 15h4"/><path d="M9 3v4"/><path d="M15 3v4"/><path d="M17 9h4"/><path d="M17 15h4"/><path d="M9 17v4"/><path d="M15 17v4"/></svg>
  <p class="facet-title">Size</p>
</div>
<div class="facet-chips facet-chips-last d-flex flex-wrap">
  <button type="button" class="filter-chip" data-filter="size" data-val="5" aria-pressed="false">5</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="6" aria-pressed="false">6</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="7" aria-pressed="false">7</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="8" aria-pressed="false">8</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="9" aria-pressed="false">9</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="10" aria-pressed="false">10</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="12" aria-pressed="false">12</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="14" aria-pressed="false">14</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="16" aria-pressed="false">16</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="18" aria-pressed="false">18</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="2.4" aria-pressed="false">2.4</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="2.6" aria-pressed="false">2.6</button>
  <button type="button" class="filter-chip" data-filter="size" data-val="2.8" aria-pressed="false">2.8</button>
</div>

<div class="drawer-actions d-flex">
  <button type="button" class="drawer-btn btn-outline-beyon" id="filter-clear">${Resource.msg('button.clearall', 'beyon', null)}</button>
  <button type="button" class="drawer-btn btn-cta" id="filter-apply">${Resource.msg('button.apply', 'beyon', null)}</button>
</div>
    </div>
