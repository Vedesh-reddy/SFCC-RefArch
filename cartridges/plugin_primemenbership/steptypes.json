                        {
                            "@name": "MaxItems",
                            "@type": "long",
                            "@required": "false",
                            "description": "Maximum records per run",
                            "default-value": "2000",
                            "min-value": "1",
                            "max-value": "10000"
                        }
                    ]
                },
