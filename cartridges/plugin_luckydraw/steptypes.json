                "@type-id": "custom.LuckyDraw.Status",
                "@supports-parallel-execution": "false",
                "@supports-site-context": "true",
                "@supports-organization-context": "false",
                "description": "Start scheduled campaigns and complete finished ones",
                "module": "plugin_luckydraw/cartridge/scripts/jobs/luckydraw.js",
                "function": "status",
                "transactional": "false",
                "timeout-in-seconds": 1800,
                "parameters": {
                    "parameter": [
                        {
                            "@name": "MaxItems",
                            "@type": "long",
                            "@required": "false",
                            "description": "Maximum records per run",
                            "default-value": "200",
                            "min-value": "1",
                            "max-value": "10000"
                        }
                    ]
                },
                "status-codes": {
                    "status": [
                        {
                            "@code": "OK",
                            "description": "Finished"
                        },
                        {
                            "@code": "DISABLED",
                            "description": "Lucky draw disabled"
                        },
                        {
                            "@code": "ATTENTION",
                            "description": "Finished with failures; see the log and cases"
                        },
                        {
                            "@code": "ERROR",
                            "description": "Failed"
                        }
                    ]
                }
