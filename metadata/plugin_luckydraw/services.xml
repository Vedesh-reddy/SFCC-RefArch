<?xml version="1.0" encoding="UTF-8"?>
<services xmlns="http://www.demandware.com/xml/impex/services/2014-09-26">
    <service-credential service-credential-id="plugin-luckydraw.hmac">
        <url>https://localhost/plugin-luckydraw-key-holder</url>
        <user-id/>
    </service-credential>
    <service-profile service-profile-id="plugin-luckydraw.hmac">
        <timeout-millis>1000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>true</cb-enabled>
        <cb-calls>5</cb-calls>
        <cb-millis>60000</cb-millis>
    </service-profile>
    <service service-id="plugin-luckydraw.hmac">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>plugin-luckydraw</log-prefix>
        <comm-log-enabled>false</comm-log-enabled>
        <force-prd-enabled>false</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>plugin-luckydraw.hmac</profile-id>
        <credential-id>plugin-luckydraw.hmac</credential-id>
    </service>
</services>
