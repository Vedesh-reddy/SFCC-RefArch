<?xml version="1.0" encoding="UTF-8"?>
<jobs xmlns="http://www.demandware.com/xml/impex/jobs/2015-07-01">
    <job job-id="LuckyDraw-Job">
        <description>All lucky draw tasks. Runs every 5 minutes; slower steps wait for their own RunEveryMinutes.</description>
        <parameters/>
        <flow>
            <context site-id="RefArch_Practice"/>
            <step step-id="Status" type="custom.LuckyDraw.Status" enforce-restart="false">
                <description>Start scheduled campaigns and complete finished ones</description>
                <parameters>
                    <parameter name="MaxItems">200</parameter>
                    <parameter name="RunEveryMinutes">15</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Entries" type="custom.LuckyDraw.Entries" enforce-restart="false">
                <description>Create entries from paid orders of running campaigns</description>
                <parameters>
                    <parameter name="MaxItems">1000</parameter>
                    <parameter name="RunEveryMinutes">15</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Reconcile" type="custom.LuckyDraw.Reconcile" enforce-restart="false">
                <description>Entry reconciliation: cancel entries of cancelled or unpaid orders, activate entries after the hold period</description>
                <parameters>
                    <parameter name="MaxItems">1000</parameter>
                    <parameter name="RunEveryMinutes">60</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Draw" type="custom.LuckyDraw.Draw" enforce-restart="false">
                <description>Commit seeds of opened windows and execute due draws</description>
                <parameters>
                    <parameter name="MaxItems">1000</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Verify" type="custom.LuckyDraw.Verify" enforce-restart="false">
                <description>Winner verification: revalidate winners, recompute finished draws, release alternates</description>
                <parameters>
                    <parameter name="MaxItems">200</parameter>
                    <parameter name="RunEveryMinutes">60</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Rewards" type="custom.LuckyDraw.Rewards" enforce-restart="false">
                <description>Issue coupon rewards with retries, sync redemptions, expire codes</description>
                <parameters>
                    <parameter name="MaxItems">200</parameter>
                    <parameter name="RunEveryMinutes">15</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="AuditExport" type="custom.LuckyDraw.AuditExport" enforce-restart="false">
                <description>Export new audit events to IMPEX as JSON lines</description>
                <parameters>
                    <parameter name="MaxItems">5000</parameter>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Notifications" type="custom.LuckyDraw.Notifications" enforce-restart="false">
                <description>Deliver queued lucky draw e-mails with retries</description>
                <parameters>
                    <parameter name="MaxItems">500</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Cleanup" type="custom.LuckyDraw.Cleanup" enforce-restart="false">
                <description>Remove expired locks, rate buckets and old request keys</description>
                <parameters>
                    <parameter name="MaxItems">1000</parameter>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="ReportFailures" type="custom.LuckyDraw.ReportFailures" enforce-restart="false">
                <description>Fails the job when an earlier step failed, so Business Manager shows it</description>
                <parameters/>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-recurring enabled="false">
                <recurrence>
                    <date-from>2026-01-01Z</date-from>
                    <start-time>00:00:00.000Z</start-time>
                    <interval>5m</interval>
                    <day-of-week>
                        <weekday>Monday</weekday>
                        <weekday>Tuesday</weekday>
                        <weekday>Wednesday</weekday>
                        <weekday>Thursday</weekday>
                        <weekday>Friday</weekday>
                        <weekday>Saturday</weekday>
                        <weekday>Sunday</weekday>
                    </day-of-week>
                </recurrence>
            </run-recurring>
        </triggers>
    </job>
</jobs>
