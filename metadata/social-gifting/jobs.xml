<?xml version="1.0" encoding="UTF-8"?>
<jobs xmlns="http://www.demandware.com/xml/impex/jobs/2015-07-01">
    <job job-id="SocialGifting-Job">
        <description>All gift registry tasks. Runs every 5 minutes.</description>
        <parameters/>
        <flow>
            <context site-id="RefArch_Practice"/>
            <step step-id="RegistryLifecycleJob" type="custom.SocialGifting.RegistryLifecycleJob" enforce-restart="false">
                <description>RegistryLifecycleJob</description>
                <parameters/>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="ReconcileRegistryOrders" type="custom.SocialGifting.ReconcileRegistryOrders" enforce-restart="false">
                <description>ReconcileRegistryOrders</description>
                <parameters/>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="SendRegistryNotifications" type="custom.SocialGifting.SendRegistryNotifications" enforce-restart="false">
                <description>SendRegistryNotifications</description>
                <parameters/>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="ReportFailures" type="custom.SocialGifting.ReportFailures" enforce-restart="false">
                <description>Fails the job when an earlier step failed, so Business Manager shows it</description>
                <parameters/>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-recurring enabled="false">
                <recurrence>
                    <date-from>2026-01-01Z</date-from>
                    <start-time>00:00:00.000Z</start-time>
                    <interval>5m</interval>
                    <day-of-week>
                        <weekday>Monday</weekday>
                        <weekday>Tuesday</weekday>
                        <weekday>Wednesday</weekday>
                        <weekday>Thursday</weekday>
                        <weekday>Friday</weekday>
                        <weekday>Saturday</weekday>
                        <weekday>Sunday</weekday>
                    </day-of-week>
                </recurrence>
            </run-recurring>
        </triggers>
    </job>
</jobs>
