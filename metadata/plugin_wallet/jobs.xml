<?xml version="1.0" encoding="UTF-8"?>
<jobs xmlns="http://www.demandware.com/xml/impex/jobs/2015-07-01">
    <job job-id="Wallet-Job">
        <description>All wallet tasks. Runs every 5 minutes; slower steps wait for their own RunEveryMinutes.</description>
        <parameters/>
        <flow>
            <context site-id="RefArch_Practice"/>
            <step step-id="Holds" type="custom.Wallet.Holds" enforce-restart="false">
                <description>Capture holds of placed orders, release failed/cancelled ones, review stuck holds, expire approvals and invitations</description>
                <parameters>
                    <parameter name="MaxItems">500</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="TopUps" type="custom.Wallet.TopUps" enforce-restart="false">
                <description>Verify open top-ups with the gateway and expire stale ones</description>
                <parameters>
                    <parameter name="MaxItems">200</parameter>
                    <parameter name="RunEveryMinutes">10</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Expiry" type="custom.Wallet.Expiry" enforce-restart="false">
                <description>Expire inactive balances (off unless walletFundsExpiryDays is set)</description>
                <parameters>
                    <parameter name="MaxItems">100</parameter>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Risk" type="custom.Wallet.Risk" enforce-restart="false">
                <description>Flag wallets with suspicious refund activity</description>
                <parameters>
                    <parameter name="MaxItems">5000</parameter>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Reconcile" type="custom.Wallet.Reconcile" enforce-restart="false">
                <description>Replay wallets against balances, check journal balance and captured holds against orders</description>
                <parameters>
                    <parameter name="MaxItems">200</parameter>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Notifications" type="custom.Wallet.Notifications" enforce-restart="false">
                <description>Send queued wallet e-mails with retries</description>
                <parameters>
                    <parameter name="MaxItems">500</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Cleanup" type="custom.Wallet.Cleanup" enforce-restart="false">
                <description>Remove expired technical records</description>
                <parameters>
                    <parameter name="MaxItems">1000</parameter>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="ReportFailures" type="custom.Wallet.ReportFailures" enforce-restart="false">
                <description>Fails the job when an earlier step failed, so Business Manager shows it</description>
                <parameters/>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-recurring enabled="false">
                <recurrence>
                    <date-from>2026-01-01Z</date-from>
                    <start-time>00:00:00.000Z</start-time>
                    <interval>5m</interval>
                    <day-of-week>
                        <weekday>Monday</weekday>
                        <weekday>Tuesday</weekday>
                        <weekday>Wednesday</weekday>
                        <weekday>Thursday</weekday>
                        <weekday>Friday</weekday>
                        <weekday>Saturday</weekday>
                        <weekday>Sunday</weekday>
                    </day-of-week>
                </recurrence>
            </run-recurring>
        </triggers>
    </job>
</jobs>
