<?xml version="1.0" encoding="UTF-8"?>
<jobs xmlns="http://www.demandware.com/xml/impex/jobs/2015-07-01">
    <job job-id="MarketplaceSeller-Job">
        <description>All marketplace tasks. Runs every 5 minutes; slower steps wait for their own RunEveryMinutes. Offer sync and product publishing run last because each needs its steps to succeed in order.</description>
        <parameters/>
        <flow>
            <context site-id="RefArch_Practice"/>
            <step step-id="OrderSync" type="custom.MarketplaceSeller.OrderSync" enforce-restart="false">
                <description>Create and advance seller orders, close finished ones, book deferred earnings</description>
                <parameters>
                    <parameter name="MaxItems">500</parameter>
                    <parameter name="RunEveryMinutes">15</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Settlements" type="custom.MarketplaceSeller.Settlements" enforce-restart="false">
                <description>Create seller settlements and optionally request payouts</description>
                <parameters>
                    <parameter name="MaxItems">200</parameter>
                    <parameter name="AutoRequestPayout">false</parameter>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Reconcile" type="custom.MarketplaceSeller.Reconcile" enforce-restart="false">
                <description>Reconcile settlements against the ledger</description>
                <parameters>
                    <parameter name="MaxItems">200</parameter>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Performance" type="custom.MarketplaceSeller.Performance" enforce-restart="false">
                <description>Evaluate seller performance metrics and ratings</description>
                <parameters>
                    <parameter name="MaxItems">200</parameter>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Reminders" type="custom.MarketplaceSeller.Reminders" enforce-restart="false">
                <description>Remind admins about reviews waiting too long</description>
                <parameters>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="DocumentExpiry" type="custom.MarketplaceSeller.DocumentExpiry" enforce-restart="false">
                <description>Warn about and handle expiring seller documents</description>
                <parameters>
                    <parameter name="MaxItems">500</parameter>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Recovery" type="custom.MarketplaceSeller.Recovery" enforce-restart="false">
                <description>Retry failed verification calls and flag unanswered payouts</description>
                <parameters>
                    <parameter name="MaxItems">100</parameter>
                    <parameter name="StalePayoutHours">48</parameter>
                    <parameter name="RunEveryMinutes">60</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Notifications" type="custom.MarketplaceSeller.Notifications" enforce-restart="false">
                <description>Send queued seller and admin e-mail notifications with retries</description>
                <parameters>
                    <parameter name="MaxItems">500</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="Cleanup" type="custom.MarketplaceSeller.Cleanup" enforce-restart="false">
                <description>Remove expired technical records and purge documents past retention</description>
                <parameters>
                    <parameter name="MaxItems">1000</parameter>
                    <parameter name="RunEveryMinutes">1440</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="SyncPrepare" type="custom.MarketplaceSeller.SyncPrepare" enforce-restart="false">
                <description>Write changed seller stock, featured prices and aggregates</description>
                <parameters>
                    <parameter name="MaxItems">1000</parameter>
                    <parameter name="RunEveryMinutes">15</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
        </flow>
        <flow>
            <context site-id="Sites"/>
            <step step-id="SyncImportInventory" type="ImportInventoryLists" enforce-restart="false">
                <description>ImportInventory</description>
                <parameters>
                    <parameter name="WorkingFolder">plugin-seller/sync/inventory</parameter>
                    <parameter name="FileNamePattern">.*\.xml</parameter>
                    <parameter name="NoFilesFoundHandling">NO_FILES_FOUND</parameter>
                    <parameter name="ImportMode">Merge</parameter>
                    <parameter name="ImportFailedHandling">ERROR</parameter>
                    <parameter name="AfterImportFileHandling">Archive Zipped</parameter>
                    <parameter name="ArchiveFolder">archive/plugin-seller</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="SyncImportPrices" type="ImportPriceBook" enforce-restart="false">
                <description>ImportPrices</description>
                <parameters>
                    <parameter name="WorkingFolder">plugin-seller/sync/pricebook</parameter>
                    <parameter name="FileNamePattern">.*\.xml</parameter>
                    <parameter name="NoFilesFoundHandling">NO_FILES_FOUND</parameter>
                    <parameter name="ImportMode">Merge</parameter>
                    <parameter name="ImportFailedHandling">ERROR</parameter>
                    <parameter name="AfterImportFileHandling">Archive Zipped</parameter>
                    <parameter name="ArchiveFolder">archive/plugin-seller</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="SyncImportProducts" type="ImportCatalog" enforce-restart="false">
                <description>ImportProducts</description>
                <parameters>
                    <parameter name="WorkingFolder">plugin-seller/sync/catalog</parameter>
                    <parameter name="FileNamePattern">.*\.xml</parameter>
                    <parameter name="NoFilesFoundHandling">NO_FILES_FOUND</parameter>
                    <parameter name="ImportMode">Merge</parameter>
                    <parameter name="ImportFailedHandling">ERROR</parameter>
                    <parameter name="AfterImportFileHandling">Archive Zipped</parameter>
                    <parameter name="ArchiveFolder">archive/plugin-seller</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
        </flow>
        <flow>
            <context site-id="RefArch_Practice"/>
            <step step-id="SyncConfirm" type="custom.MarketplaceSeller.SyncConfirm" enforce-restart="false">
                <description>Confirm the offer sync after the imports and flag missing inventory records</description>
                <parameters/>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="ProvisionPrepare" type="custom.MarketplaceSeller.ProvisionPrepare" enforce-restart="false">
                <description>Prepare approved product submissions (import files or SCAPI Admin calls)</description>
                <parameters>
                    <parameter name="MaxItems">50</parameter>
                    <parameter name="RunEveryMinutes">30</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
        </flow>
        <flow>
            <context site-id="Sites"/>
            <step step-id="ProvisionImportProducts" type="ImportCatalog" enforce-restart="false">
                <description>ImportProducts</description>
                <parameters>
                    <parameter name="WorkingFolder">plugin-seller/provision/catalog</parameter>
                    <parameter name="FileNamePattern">.*\.xml</parameter>
                    <parameter name="NoFilesFoundHandling">NO_FILES_FOUND</parameter>
                    <parameter name="ImportMode">Merge</parameter>
                    <parameter name="ImportFailedHandling">ERROR</parameter>
                    <parameter name="AfterImportFileHandling">Archive Zipped</parameter>
                    <parameter name="ArchiveFolder">archive/plugin-seller</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="ProvisionImportPrices" type="ImportPriceBook" enforce-restart="false">
                <description>ImportPrices</description>
                <parameters>
                    <parameter name="WorkingFolder">plugin-seller/provision/pricebook</parameter>
                    <parameter name="FileNamePattern">.*\.xml</parameter>
                    <parameter name="NoFilesFoundHandling">NO_FILES_FOUND</parameter>
                    <parameter name="ImportMode">Merge</parameter>
                    <parameter name="ImportFailedHandling">ERROR</parameter>
                    <parameter name="AfterImportFileHandling">Archive Zipped</parameter>
                    <parameter name="ArchiveFolder">archive/plugin-seller</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="ProvisionImportInventory" type="ImportInventoryLists" enforce-restart="false">
                <description>ImportInventory</description>
                <parameters>
                    <parameter name="WorkingFolder">plugin-seller/provision/inventory</parameter>
                    <parameter name="FileNamePattern">.*\.xml</parameter>
                    <parameter name="NoFilesFoundHandling">NO_FILES_FOUND</parameter>
                    <parameter name="ImportMode">Merge</parameter>
                    <parameter name="ImportFailedHandling">ERROR</parameter>
                    <parameter name="AfterImportFileHandling">Archive Zipped</parameter>
                    <parameter name="ArchiveFolder">archive/plugin-seller</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
        </flow>
        <flow>
            <context site-id="RefArch_Practice"/>
            <step step-id="ProvisionVerify" type="custom.MarketplaceSeller.ProvisionVerify" enforce-restart="false">
                <description>Verify provisioned products and publish complete submissions</description>
                <parameters>
                    <parameter name="MaxItems">200</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="ReportFailures" type="custom.MarketplaceSeller.ReportFailures" enforce-restart="false">
                <description>Fails the job when an earlier step failed, so Business Manager shows it</description>
                <parameters/>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-recurring enabled="false">
                <recurrence>
                    <date-from>2026-01-01Z</date-from>
                    <start-time>00:00:00.000Z</start-time>
                    <interval>5m</interval>
                    <day-of-week>
                        <weekday>Monday</weekday>
                        <weekday>Tuesday</weekday>
                        <weekday>Wednesday</weekday>
                        <weekday>Thursday</weekday>
                        <weekday>Friday</weekday>
                        <weekday>Saturday</weekday>
                        <weekday>Sunday</weekday>
                    </day-of-week>
                </recurrence>
            </run-recurring>
        </triggers>
    </job>
</jobs>
