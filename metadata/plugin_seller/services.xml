<?xml version="1.0" encoding="UTF-8"?>
<services xmlns="http://www.demandware.com/xml/impex/services/2014-09-26">
    <service-credential service-credential-id="plugin-seller.hmac">
        <url>https://localhost/plugin-seller-key-holder</url>
        <user-id/>
    </service-credential>
    <service-credential service-credential-id="plugin-seller.webhook">
        <url>https://localhost/plugin-seller-webhook-secret</url>
        <user-id/>
    </service-credential>
    <service-credential service-credential-id="plugin-seller.am.oauth">
        <url>https://account.demandware.com/dwsso/oauth2/access_token</url>
        <user-id/>
    </service-credential>
    <service-credential service-credential-id="plugin-seller.scapi.admin">
        <url>https://SHORTCODE.api.commercecloud.salesforce.com</url>
        <user-id/>
    </service-credential>
    <service-profile service-profile-id="plugin-seller.hmac">
        <timeout-millis>1000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>true</cb-enabled>
        <cb-calls>5</cb-calls>
        <cb-millis>60000</cb-millis>
    </service-profile>
    <service-profile service-profile-id="plugin-seller.webhook">
        <timeout-millis>1000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>true</cb-enabled>
        <cb-calls>5</cb-calls>
        <cb-millis>60000</cb-millis>
    </service-profile>
    <service-profile service-profile-id="plugin-seller.am.oauth">
        <timeout-millis>10000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>true</cb-enabled>
        <cb-calls>5</cb-calls>
        <cb-millis>60000</cb-millis>
    </service-profile>
    <service-profile service-profile-id="plugin-seller.scapi.admin">
        <timeout-millis>15000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>true</cb-enabled>
        <cb-calls>5</cb-calls>
        <cb-millis>60000</cb-millis>
    </service-profile>
    <service service-id="plugin-seller.hmac">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>plugin-seller</log-prefix>
        <comm-log-enabled>false</comm-log-enabled>
        <force-prd-enabled>false</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>plugin-seller.hmac</profile-id>
        <credential-id>plugin-seller.hmac</credential-id>
    </service>
    <service service-id="plugin-seller.webhook">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>plugin-seller</log-prefix>
        <comm-log-enabled>false</comm-log-enabled>
        <force-prd-enabled>false</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>plugin-seller.webhook</profile-id>
        <credential-id>plugin-seller.webhook</credential-id>
    </service>
    <service service-id="plugin-seller.am.oauth">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>plugin-seller</log-prefix>
        <comm-log-enabled>false</comm-log-enabled>
        <force-prd-enabled>false</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>plugin-seller.am.oauth</profile-id>
        <credential-id>plugin-seller.am.oauth</credential-id>
    </service>
    <service service-id="plugin-seller.scapi.admin">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>plugin-seller</log-prefix>
        <comm-log-enabled>false</comm-log-enabled>
        <force-prd-enabled>false</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>plugin-seller.scapi.admin</profile-id>
        <credential-id>plugin-seller.scapi.admin</credential-id>
    </service>
</services>
