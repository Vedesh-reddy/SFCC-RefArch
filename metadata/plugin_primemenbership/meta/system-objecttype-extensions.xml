    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="primeMembershipEnabled">
                <display-name xml:lang="x-default">primeMembershipEnabled</display-name>
                <description xml:lang="x-default">Master switch. Stays off until the configuration check in Business Manager passes.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="primeMembershipCurrency">
                <display-name xml:lang="x-default">primeMembershipCurrency</display-name>
                <description xml:lang="x-default">Membership currency. Only USD is supported.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
                <default-value>USD</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="primeMembershipQuoteMinutes">
                <display-name xml:lang="x-default">primeMembershipQuoteMinutes</display-name>
                <description xml:lang="x-default">How long a price quote stays valid. Keep below 15: temporary baskets are deleted after 15 minutes.</description>
                <type>int</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>14</default-value>
