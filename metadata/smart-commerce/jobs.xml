<?xml version="1.0" encoding="UTF-8"?>
<jobs xmlns="http://www.demandware.com/xml/impex/jobs/2015-07-01">
    <job job-id="SmartCommerce-Job">
        <description>All smart commerce tasks. Runs hourly; RecordPriceHistory runs only in the hour set by RunAtHourUTC.</description>
        <parameters/>
        <flow>
            <context site-id="RefArch_Practice"/>
            <step step-id="RecordPriceHistory" type="custom.SmartCommerce.RecordPriceHistory" enforce-restart="false">
                <description>Records a price change point for every online product whose price changed since the last run.</description>
                <parameters>
                    <parameter name="RunAtHourUTC">1</parameter>
                </parameters>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="SendProductAlerts" type="custom.SmartCommerce.SendProductAlerts" enforce-restart="false">
                <description>Emails triggered back-in-stock and price-drop alerts and expires old ones.</description>
                <parameters/>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="ExpirePriceLocks" type="custom.SmartCommerce.ExpirePriceLocks" enforce-restart="false">
                <description>Marks pending and active price locks past their expiry as expired.</description>
                <parameters/>
                <rules>
                    <on-exit status="ERROR">
                        <continue/>
                    </on-exit>
                </rules>
            </step>
            <step step-id="ReportFailures" type="custom.SmartCommerce.ReportFailures" enforce-restart="false">
                <description>Fails the job when an earlier step failed, so Business Manager shows it</description>
                <parameters/>
                <rules>
                    <on-exit status="ERROR">
                        <stop-job/>
                    </on-exit>
                </rules>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-recurring enabled="true">
                <recurrence>
                    <date-from>2026-01-01Z</date-from>
                    <start-time>00:15:00.000Z</start-time>
                    <interval>1h</interval>
                    <day-of-week>
                        <weekday>Monday</weekday>
                        <weekday>Tuesday</weekday>
                        <weekday>Wednesday</weekday>
                        <weekday>Thursday</weekday>
                        <weekday>Friday</weekday>
                        <weekday>Saturday</weekday>
                        <weekday>Sunday</weekday>
                    </day-of-week>
                </recurrence>
            </run-recurring>
        </triggers>
    </job>
</jobs>
